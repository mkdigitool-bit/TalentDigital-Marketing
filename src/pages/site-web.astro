---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Hero3D from '../components/Hero3D.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import { site } from '../data/site';

const included = [
  {
    n: '01',
    t: 'Cadrage et arborescence',
    d: 'Objectif du site, cible, page par page : quel visiteur arrive, quelle question il se pose, quelle action on attend de lui. L’arborescence est validée avant toute maquette.',
  },
  {
    n: '02',
    t: 'Design et intégration',
    d: 'Une direction artistique alignée sur votre positionnement, intégrée en responsive. Testée sur mobile, tablette et ordinateur, sur les navigateurs principaux.',
  },
  {
    n: '03',
    t: 'Contenus et structure éditoriale',
    d: 'Rédaction ou réécriture des pages principales : accueil, offre, à propos, contact. Hiérarchie des titres, messages clés, appels à l’action.',
  },
  {
    n: '04',
    t: 'SEO technique de base',
    d: 'Balises title et meta description, données structurées, sitemap, robots.txt, URLs propres, redirections si le site remplace un ancien. Ce socle est inclus, pas facturé en option.',
  },
  {
    n: '05',
    t: 'Performance et accessibilité',
    d: 'Images optimisées, chargement différé, polices maîtrisées, contrastes et navigation clavier vérifiés. L’objectif est un site rapide et lisible, mesuré avant livraison plutôt que promis.',
  },
  {
    n: '06',
    t: 'Mesure et prise en main',
    d: 'Suivi des conversions configuré (avec consentement), tableau de bord minimal, et une session de prise en main documentée pour que vous puissiez modifier vos pages.',
  },
];

const notIncluded = [
  'Budget publicitaire et frais de régie',
  'Abonnements hébergement, CMS, licences et extensions',
  'Production photo, vidéo ou illustration originale',
  'Rédaction de contenus au-delà du périmètre écrit',
  'Maintenance, mises à jour et évolutions après livraison',
  'Refonte de l’identité visuelle ou du logo',
];

const steps = [
  { n: '01', t: 'Cadrage', d: 'Un entretien, un document d’arborescence, un périmètre validé. C’est ici que se décide 80 % du résultat.' },
  { n: '02', t: 'Contenus', d: 'Rédaction ou collecte des textes, choix des visuels, validation avant intégration. On n’intègre pas du contenu provisoire destiné à rester.' },
  { n: '03', t: 'Design', d: 'Une proposition de direction artistique sur les pages clés. Deux séries d’ajustements incluses, puis validation.' },
  { n: '04', t: 'Intégration', d: 'Développement, responsive, tests, optimisation des performances et du référencement technique.' },
  { n: '05', t: 'Mise en ligne', d: 'Transfert des accès, vérification des redirections, indexation, mesure des conversions.' },
  { n: '06', t: 'Prise en main', d: 'Session de formation, documentation écrite, et période de garantie sur les anomalies de livraison.' },
];

const profiles = [
  { t: 'Vous refaites un site devenu illisible', d: 'Le site a grandi par ajouts successifs. La navigation ne suit plus, les messages se contredisent, et vous ne savez plus quelle page sert à quoi.' },
  { t: 'Vous lancez une activité ou une offre', d: 'Il n’y a pas encore de site, ou seulement une page de présentation. Il faut une base sérieuse, sans surdimensionner.' },
  { t: 'Vous changez de positionnement', d: 'Le site raconte une histoire qui n’est plus la vôtre. L’offre a évolué, la cible aussi, et le discours doit suivre.' },
  { t: 'Vous voulez arrêter de dépendre d’un prestataire', d: 'Le site existe mais vous n’avez pas les accès, ou chaque modification passe par un devis. Il faut reprendre la main.' },
];

const faq = [
  {
    q: 'Combien coûte un site web ?',
    a: 'Le prix dépend du nombre de pages, du niveau de rédaction attendu et des intégrations nécessaires. Une fourchette est donnée après le premier échange, et le devis détaille le périmètre. Aucun tarif ferme n’est publié sans savoir ce que le site doit faire.',
  },
  {
    q: 'Combien de temps pour livrer ?',
    a: 'Le délai est inscrit au devis. Il dépend du nombre de pages et surtout de la disponibilité des contenus et des validations. Le calendrier court à partir du moment où les éléments nécessaires sont réunis — pas avant, pour éviter les délais annoncés puis repoussés.',
  },
  {
    q: 'Quelle technologie utilisez-vous ?',
    a: 'Selon le besoin : site statique rapide, CMS si vous publiez régulièrement, ou framework applicatif si le site inclut des fonctionnalités sur mesure. Le choix est justifié au devis, avec ses conséquences en coût de maintenance. Nous ne vendons pas une technologie par habitude.',
  },
  {
    q: 'Puis-je modifier mon site moi-même ?',
    a: 'Oui, c’est prévu. La prise en main inclut une session et une documentation écrite : où modifier un texte, comment ajouter une page, ce qu’il ne faut pas toucher. Si vous ne souhaitez pas gérer, la maintenance est une option séparée.',
  },
  {
    q: 'Garantissez-vous un score PageSpeed ?',
    a: 'Non. Nous optimisons les performances et mesurons les résultats avant livraison, mais un score dépend aussi de l’hébergement, des scripts tiers que vous ajoutez ensuite et des conditions de test. Un score affiché comme garantie serait une promesse invérifiable au moment où elle compte.',
  },
  {
    q: 'Que se passe-t-il si le site remplace un site existant ?',
    a: 'Les redirections sont traitées dans le périmètre : les anciennes URLs utiles pointent vers les nouvelles. C’est ce qui évite de perdre le référencement acquis. Si l’ancien site a des centaines d’URLs, cela peut être un chantier distinct, chiffré séparément.',
  },
];

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Sites web professionnels',
  serviceType: 'Création de site web',
  description:
    'Conception de sites web professionnels : cadrage, design, intégration, rédaction, SEO technique, mesure des conversions et prise en main documentée.',
  url: `${site.domain}/site-web`,
  provider: { '@id': `${site.domain}/#organization` },
  areaServed: site.areas,
};
---

<BaseLayout
  title="Création de site web : cadrage et design"
  description="Sites web professionnels construits dans un périmètre écrit : cadrage, design, intégration, SEO technique et mesure. Vous gardez les accès et le code."
>
  <section class="page-hero page-hero--scene">
    <Hero3D variant="orbital" />
    <div class="wrap page-hero__inner">
      <Breadcrumbs items={[{ label: 'Solutions digitales', href: '/solutions-digitales' }, { label: 'Site web' }]} />
      <div class="hero-copy">
        <span class="eyebrow">Solution 01 — Site web</span>
        <h1 class="display-1 reveal" style="margin-top:1rem">Un site qui explique, et qui <em>convertit</em>.</h1>
        <p class="lede reveal" style="margin-top:1.5rem;max-width:50ch">
          Pas une vitrine décorative. Un site dont chaque page a un objectif : répondre à une question
          précise et conduire à une action claire.
        </p>
        <div class="hero-actions reveal">
          <a href="/contact" class="btn">Discutons de votre projet
            <svg class="arr" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/solutions-digitales" class="btn btn--ghost">Voir tous les supports</a>
        </div>
        <p class="note" style="margin-top:1.2rem">Périmètre écrit avant devis · Accès et code remis · Prise en main incluse</p>
      </div>
    </div>
  </section>

  <div class="wrap hero-note">
    <aside class="side-note side-note--strip reveal">
      <p class="side-note__h">La question à trancher d’abord</p>
      <p>
        Un site ne résout pas un problème d’offre, de prix ou de preuve. Si le diagnostic montre
        que le blocage est ailleurs, nous le disons avant de chiffrer un site.
      </p>
      <a href="/audit" class="side-note__link">Demander un audit →</a>
    </aside>
  </div>

  <section class="section wrap">
    <div class="section__head reveal">
      <p class="section-label">Pour qui</p>
      <h2>Quatre situations où un site est la bonne <em>réponse</em>.</h2>
    </div>
    <div class="two-grid">
      {profiles.map((p) => (
        <article class="mini-card reveal">
          <h3>{p.t}</h3>
          <p>{p.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="section__head reveal">
      <p class="section-label">Ce qui est inclus</p>
      <h2>Six livrables nommés, pas une <em>prestation floue</em>.</h2>
    </div>
    <div class="deliver-grid reveal">
      {included.map((item) => (
        <article class="deliver-item">
          <p class="deliver-item__no">{item.n} — inclus</p>
          <h4>{item.t}</h4>
          <p>{item.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="split">
      <div class="reveal">
        <p class="section-label">Déroulé</p>
        <h2>Six étapes, du cadrage à la <em>prise en main</em>.</h2>
        <p class="lede" style="margin-top:1rem">
          Chaque étape se termine par une validation. Rien n’est intégré sans contenu validé,
          et rien n’est mis en ligne sans test.
        </p>
      </div>
      <div class="steps-list">
        {steps.map((s) => (
          <div class="step-row reveal">
            <span class="step-row__n">{s.n}</span>
            <div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="split">
      <div class="reveal">
        <p class="section-label">Transparence</p>
        <h2>Ce qui n’est pas dans le <em>devis</em>.</h2>
        <p class="lede" style="margin-top:1rem">
          Un devis clair dit aussi ce qu’il ne couvre pas. Cela évite les mauvaises surprises
          en cours de projet, des deux côtés.
        </p>
      </div>
      <div class="not-list reveal">
        <ul>
          {notIncluded.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="faq-split">
      <div class="reveal">
        <p class="section-label">Questions</p>
        <h2>Les questions qu’on nous pose <em>avant</em> de commander.</h2>
      </div>
      <Faq items={faq} idPrefix="siteweb-faq" />
    </div>
  </section>

  <Cta
    title="Un site à construire ou à <em>reprendre</em> ?"
    text="Décrivez votre activité et ce que le site doit accomplir. Nous revenons avec les questions à trancher avant de chiffrer — pas une maquette envoyée au hasard."
    primaryLabel="Discutons de votre projet"
    primaryHref="/contact"
    secondaryLabel="Voir la méthode"
    secondaryHref="/methode"
  />

  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</BaseLayout>

<style>
  .two-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}
  .mini-card{border-top:1px solid var(--line-2);padding-top:1.1rem}
  .mini-card h3{font-size:1.02rem;font-weight:800;letter-spacing:-.01em;line-height:1.35}
  .mini-card p{font-size:.88rem;color:var(--muted);line-height:1.62;margin-top:.5rem}

  .steps-list{display:flex;flex-direction:column;border-top:1px solid var(--line-2)}
  .step-row{display:flex;gap:1.1rem;padding:1.15rem 0;border-bottom:1px solid var(--line)}
  .step-row__n{font-family:var(--mono);font-size:.72rem;color:var(--accent);padding-top:.15rem}
  .step-row h3{font-size:.98rem;font-weight:800;letter-spacing:-.01em}
  .step-row p{font-size:.86rem;color:var(--muted);line-height:1.6;margin-top:.3rem}

  .not-list{border:1px solid var(--line);border-radius:8px;background:var(--panel);padding:1.5rem}
  .not-list ul{list-style:none;display:flex;flex-direction:column;gap:.7rem}
  .not-list li{font-size:.88rem;color:var(--muted);line-height:1.55;padding-left:1.2rem;position:relative}
  .not-list li::before{content:"×";position:absolute;left:0;color:var(--danger);font-family:var(--mono);font-weight:700}

  .faq-split{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(2rem,5vw,4.5rem);align-items:start}

  @media (max-width:960px){.faq-split{grid-template-columns:1fr}}
  @media (max-width:640px){.two-grid{grid-template-columns:1fr}}
</style>
