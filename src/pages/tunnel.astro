---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Hero3D from '../components/Hero3D.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import { site } from '../data/site';

const stages = [
  {
    n: '01',
    t: 'Capture',
    d: 'Une page qui échange quelque chose d’utile — diagnostic, guide, essai, devis — contre un contact. Le formulaire est court : chaque champ supplémentaire réduit le nombre de réponses.',
    kpi: 'Taux de conversion de la page de capture',
  },
  {
    n: '02',
    t: 'Présentation de l’offre',
    d: 'La page qui argumente : problème, solution, preuve, prix ou mode de tarification, objections traitées. C’est ici que se décide l’achat.',
    kpi: 'Taux de passage à l’étape suivante',
  },
  {
    n: '03',
    t: 'Commande ou prise de rendez-vous',
    d: 'Un parcours de commande ou de réservation sans friction : peu d’étapes, messages d’erreur lisibles, récapitulatif clair, confirmation immédiate.',
    kpi: 'Taux de complétion du parcours',
  },
  {
    n: '04',
    t: 'Relance par email',
    d: 'La majorité des visiteurs ne décident pas au premier passage. Une séquence courte — bienvenue, valeur, preuve, rappel — récupère une partie d’entre eux.',
    kpi: 'Taux d’ouverture et de clic par message',
  },
  {
    n: '05',
    t: 'Mesure et décision',
    d: 'Un tableau de bord par étape, avec le point d’abandon principal. On corrige l’étape la plus faible, pas celle qui semble la plus visible.',
    kpi: 'Point d’abandon et coût par acquisition',
  },
];

const included = [
  { n: '01', t: 'Cartographie du parcours', d: 'Chaque étape, son objectif, son indicateur et le point de fuite attendu. Écrit avant la production.' },
  { n: '02', t: 'Pages du tunnel', d: 'Capture, présentation de l’offre, commande ou réservation. Rédaction, design, intégration responsive.' },
  { n: '03', t: 'Séquence email', d: 'Trois à cinq messages : bienvenue, valeur, preuve, rappel, dernier appel. Rédigés et intégrés à votre outil.' },
  { n: '04', t: 'Order bump et options', d: 'Une option complémentaire au moment de la commande, si l’offre s’y prête. Le taux d’acceptation est mesuré séparément.' },
  { n: '05', t: 'Suivi par étape', d: 'Événements de conversion à chaque étape, avec consentement. Sans cela, un tunnel ne se pilote pas.' },
  { n: '06', t: 'Documentation et transfert', d: 'Où modifier chaque page, comment ajouter un message, comment lire le tableau de bord. Comptes et données à votre nom.' },
];

const notIncluded = [
  'Budget publicitaire et frais de régie',
  'Trafic : un tunnel convertit, il ne fait pas venir les visiteurs',
  'Production photo, vidéo ou visuels originaux',
  'Abonnements : emailing, paiement, réservation, hébergement',
  'Rédaction d’une séquence email au-delà de cinq messages',
  'Exploitation mensuelle des campagnes après livraison',
];

const faq = [
  {
    q: 'Un tunnel de vente, c’est quoi exactement ?',
    a: 'C’est une suite de pages reliées entre elles, chacune avec un objectif mesurable : capter un contact, présenter une offre, permettre une commande, relancer. Par opposition à un site où le visiteur circule librement, sans parcours défini.',
  },
  {
    q: 'Faut-il un tunnel pour vendre un service ?',
    a: 'Pas systématiquement. Pour un service à forte valeur vendu par rendez-vous, une page de présentation et une prise de rendez-vous suffisent souvent. Un tunnel complet se justifie quand il y a une séquence d’étapes et un volume de visiteurs à traiter.',
  },
  {
    q: 'Combien d’emails dans la séquence ?',
    a: 'Trois à cinq messages. Au-delà, la séquence s’adresse à des prospects tièdes, ce qui est un autre travail. En dessous de trois, il manque souvent la preuve et le rappel — deux messages qui pèsent le plus.',
  },
  {
    q: 'Quel outil utilisez-vous pour les emails ?',
    a: 'Celui que vous avez déjà, si ses fonctionnalités suffisent. Sinon, une recommandation est faite au cadrage avec ses coûts. L’outil reste à votre nom : aucun compte n’est créé sous notre structure.',
  },
  {
    q: 'Peut-on mesurer un tunnel sans cookies ?',
    a: 'Partiellement. Sans consentement, la mesure est agrégée et moins précise, et l’attribution par source devient limitée. C’est une contrainte à connaître avant de lancer : elle influence la lecture des résultats, pas la possibilité de vendre.',
  },
  {
    q: 'Que se passe-t-il si le tunnel ne convertit pas ?',
    a: 'On regarde l’étape où les visiteurs s’arrêtent. Un taux de capture correct et un faible passage à la commande désigne un problème d’offre ou de prix. Une capture faible désigne un problème de promesse. Chaque cas appelle une correction différente, et le devis prévoit un temps d’ajustement.',
  },
];

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Tunnels de vente',
  serviceType: 'Création de tunnel de vente',
  description:
    'Conception de tunnels de vente : pages de capture, présentation d’offre, commande, séquence email, suivi par étape et documentation.',
  url: `${site.domain}/tunnel`,
  provider: { '@id': `${site.domain}/#organization` },
  areaServed: site.areas,
};
---

<BaseLayout
  title="Tunnel de vente : un parcours mesuré"
  description="Tunnels de vente conçus comme un parcours mesuré : capture, offre, commande, séquence email et suivi par étape. Chaque étape a un objectif et un indicateur."
>
  <section class="page-hero page-hero--scene">
    <Hero3D variant="tunnel" />
    <div class="wrap page-hero__inner">
      <Breadcrumbs items={[{ label: 'Solutions digitales', href: '/solutions-digitales' }, { label: 'Tunnel de vente' }]} />
      <div class="hero-copy">
        <span class="eyebrow">Solution 03 — Tunnel de vente</span>
        <h1 class="display-1 reveal" style="margin-top:1rem">Un parcours qui accompagne au lieu de laisser <em>partir</em>.</h1>
        <p class="lede reveal" style="margin-top:1.5rem;max-width:50ch">
          Un tunnel n’est pas une série de pages. C’est une suite d’étapes dont chacune a un objectif
          et un indicateur. Sans mesure par étape, il n’y a rien à corriger.
        </p>
        <div class="hero-actions reveal">
          <a href="/contact" class="btn">Discutons de votre projet
            <svg class="arr" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/audit-tunnel" class="btn btn--ghost">Diagnostiquer mon tunnel</a>
        </div>
        <p class="note" style="margin-top:1.2rem">Mesure par étape · Un point d’abandon identifié · Comptes et données à votre nom</p>
      </div>
    </div>
  </section>

  <div class="wrap hero-note">
    <aside class="side-note side-note--strip reveal">
      <p class="side-note__h">Avant de construire</p>
      <p>
        La question n’est pas « quel tunnel construire » mais « où les gens s’arrêtent aujourd’hui ».
        Si vous avez déjà un parcours, le diagnostic passe avant la refonte.
      </p>
      <a href="/audit-tunnel" class="side-note__link">Auto-diagnostic en 15 points →</a>
    </aside>
  </div>

  <section class="section wrap">
    <div class="section__head reveal">
      <p class="section-label">Les étapes</p>
      <h2>Cinq étapes, cinq indicateurs <em>distincts</em>.</h2>
      <p class="lede" style="margin-top:1rem">
        Un tunnel qui ne se lit qu’au chiffre d’affaires final ne dit pas où corriger. Chaque étape
        se mesure séparément, pour savoir quoi réparer.
      </p>
    </div>
    <div class="stages">
      {stages.map((s) => (
        <article class="stage reveal">
          <div class="stage__left">
            <span class="stage__n">{s.n}</span>
            <h3>{s.t}</h3>
          </div>
          <div class="stage__body">
            <p>{s.d}</p>
            <p class="stage__kpi"><b>Indicateur</b>{s.kpi}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="section__head reveal">
      <p class="section-label">Ce qui est inclus</p>
      <h2>Six livrables, du parcours à la <em>documentation</em>.</h2>
    </div>
    <div class="deliver-grid reveal">
      {included.map((item) => (
        <article class="deliver-item">
          <p class="deliver-item__no">{item.n} — inclus</p>
          <h4>{item.t}</h4>
          <p>{item.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="split">
      <div class="reveal">
        <p class="section-label">Transparence</p>
        <h2>Un tunnel ne crée pas la <em>demande</em>.</h2>
        <p class="lede" style="margin-top:1rem">
          Un bon tunnel améliore le taux de transformation du trafic existant. Il ne compense pas
          un trafic mal ciblé, une offre peu désirable ou un prix hors marché.
        </p>
        <p class="lede" style="margin-top:1rem">
          Nous le disons avant de construire : si le diagnostic montre que le blocage est en amont,
          construire un tunnel serait une dépense sans effet.
        </p>
      </div>
      <div class="not-list reveal">
        <ul>
          {notIncluded.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="faq-split">
      <div class="reveal">
        <p class="section-label">Questions</p>
        <h2>Ce qu’on nous demande sur les <em>tunnels</em>.</h2>
      </div>
      <Faq items={faq} idPrefix="tunnel-faq" />
    </div>
  </section>

  <Cta
    title="Un tunnel à construire, ou un tunnel qui ne <em>convertit</em> pas ?"
    text="Décrivez votre offre et le parcours actuel. Nous identifions ensemble l’étape qui bloque avant de proposer une construction."
    primaryLabel="Discutons de votre projet"
    primaryHref="/contact"
    secondaryLabel="Auto-diagnostic gratuit"
    secondaryHref="/audit-tunnel"
  />

  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</BaseLayout>

<style>
  .stages{display:flex;flex-direction:column;border-top:1px solid var(--line-2)}
  .stage{display:grid;grid-template-columns:220px 1fr;gap:clamp(1.2rem,3vw,2.5rem);padding:1.4rem 0;border-bottom:1px solid var(--line)}
  .stage__left{display:flex;flex-direction:column;gap:.3rem}
  .stage__n{font-family:var(--mono);font-size:.7rem;color:var(--accent);letter-spacing:.1em}
  .stage__left h3{font-size:1.05rem;font-weight:800;letter-spacing:-.01em}
  .stage__body p{font-size:.9rem;color:var(--muted);line-height:1.62}
  .stage__kpi{margin-top:.8rem;padding-top:.7rem;border-top:1px dashed var(--line);font-family:var(--mono);font-size:.72rem;color:var(--txt) !important}
  .stage__kpi b{display:block;font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-bottom:.3rem;font-weight:500}

  @media (max-width:700px){
    .stage{grid-template-columns:1fr;gap:.6rem}
    .stage__left{flex-direction:row;align-items:baseline;gap:.7rem}
  }
</style>
