---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import { site, scopes } from '../data/site';

const principles = [
  {
    no: '01',
    t: 'Le diagnostic précède la proposition',
    d: 'Aucun devis n’est envoyé sans avoir compris la situation. C’est plus lent au départ et beaucoup plus rapide ensuite : un périmètre juste évite trois allers-retours et une rallonge.',
  },
  {
    no: '02',
    t: 'Le périmètre est écrit, les limites aussi',
    d: 'Chaque mission précise ce qui est inclus, ce qui ne l’est pas, et à partir de quand un ajout devient un nouveau devis. Écrit avant, jamais discuté après.',
  },
  {
    no: '03',
    t: 'Un interlocuteur, pas un service client',
    d: 'La personne qui vous conseille est celle qui exécute. Sur certains projets techniques, un partenaire ponctuel peut intervenir, toujours sous notre responsabilité et avec votre accord.',
  },
  {
    no: '04',
    t: 'Ce qui est construit vous appartient',
    d: 'Nom de domaine, hébergement, comptes publicitaires, code, contenus, données : tout reste à votre nom. Nous remettons les accès à la livraison et nous ne les conservons pas.',
  },
];

const refused = [
  { t: 'Promettre un chiffre de résultat', d: 'Aucune position Google, aucun nombre de leads, aucun chiffre d’affaires garanti. Ces éléments dépendent de variables que personne ne contrôle entièrement.' },
  { t: 'Publier des témoignages inventés', d: 'Aucun avis client fictif, aucun logo d’entreprise utilisée sans accord. Quand il n’y a pas de témoignage disponible, il n’y en a pas — c’est tout.' },
  { t: 'Vendre de l’exécution sans diagnostic', d: 'Un site, un tunnel ou une campagne lancés sans comprendre la situation produisent une information que l’audit aurait donnée moins cher.' },
  { t: 'Retenir les accès du client', d: 'Aucun compte, aucun code source, aucune donnée ne reste chez nous à la fin d’une mission.' },
  { t: 'Facturer un périmètre non écrit', d: 'Pas de rallonge décidée en cours de route. Un ajout de périmètre fait l’objet d’un devis distinct, accepté avant exécution.' },
];

const faq = [
  {
    q: 'TalentDigital est-il une agence ?',
    a: 'Non. TalentDigital exerce comme activité indépendante de conseil et d’exécution. Il n’y a pas d’équipe salariée à présenter, pas de bureau à visiter, et nous ne prétendons pas le contraire. Sur certains projets techniques, des partenaires ponctuels peuvent intervenir, toujours sous notre responsabilité et avec votre accord.',
  },
  {
    q: 'Pourquoi n’y a-t-il pas de témoignages clients sur ce site ?',
    a: 'Parce que nous ne publions pas d’avis sans accord écrit du client concerné, et que nous préférons ne rien afficher plutôt que d’afficher quelque chose d’invérifiable. La crédibilité de cette page repose sur autre chose : la méthode publiée, les livrables nommés et le périmètre écrit.',
  },
  {
    q: 'Comment êtes-vous payé ?',
    a: 'Par forfait sur un périmètre défini, annoncé avant le démarrage. Pas de pourcentage sur votre budget publicitaire, pas de commission sur vos ventes. Sur une mission longue, un échelonnement mensuel peut être prévu au devis.',
  },
  {
    q: 'Que se passe-t-il si le courant ne passe pas ?',
    a: 'Le premier échange de trente minutes sert aussi à ça. Si la façon de travailler ne correspond pas, nous le disons — et nous pouvons orienter vers un profil plus adapté. Un projet mal engagé coûte plus cher qu’un projet refusé.',
  },
  {
    q: 'Travaillez-vous uniquement au Maroc ?',
    a: 'Le Maroc est le marché d’ancrage. Nous accompagnons aussi des clients en France, en Belgique, en Suisse et au Canada. Le travail se fait à distance, avec des points de suivi fixés à l’avance et un canal écrit pour les décisions.',
  },
  {
    q: 'Sur quels types de projets refusez-vous d’intervenir ?',
    a: 'Sur les projets où l’objectif annoncé n’est pas mesurable, où le budget ne permet pas d’apprendre quelque chose, ou lorsqu’on nous demande de garantir un résultat qui ne dépend pas de nous. Nous préférons le dire avant de signer.',
  },
];

const ld = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'À propos de TalentDigital',
  url: `${site.domain}/a-propos`,
  description:
    'TalentDigital est un cabinet indépendant de conseil marketing et de solutions digitales : méthode publiée, livrables nommés, périmètre écrit, refus assumés.',
  mainEntity: {
    '@type': 'Organization',
    name: site.name,
    url: site.domain,
    email: site.email,
    telephone: site.phone,
    slogan: site.tagline,
    description: site.promise,
    areaServed: site.areas,
    sameAs: Object.values(site.social),
  },
};
---

<BaseLayout
  title="À propos : un cabinet qui dit aussi non"
  description="Cabinet indépendant de conseil marketing et de solutions digitales : méthode publiée, livrables nommés, périmètre écrit et refus explicites."
>
  <section class="page-hero wrap">
    <Breadcrumbs items={[{ label: 'À propos' }]} />
    <div class="split page-hero__grid">
      <div>
        <span class="eyebrow">À propos</span>
        <h1 class="display-1 reveal" style="margin-top:1rem">Un cabinet qui dit ce qu’il fait, et ce qu’il ne fait <em>pas</em>.</h1>
        <p class="lede reveal" style="margin-top:1.5rem;max-width:52ch">
          TalentDigital accompagne les PME, les entrepreneurs et les entreprises de services
          francophones sur une question simple : où mettre leur budget marketing, et dans quel ordre.
        </p>
        <p class="lede reveal" style="margin-top:1rem;max-width:52ch">
          Cette page ne raconte pas d’histoire de fondateur. Elle décrit une façon de travailler,
          des engagements vérifiables et des limites assumées.
        </p>
      </div>

      <aside class="fact-card reveal">
        <p class="fact-card__h">En bref</p>
        <dl class="fact-list">
          <div><dt>Nature</dt><dd>Activité indépendante de conseil et d’exécution</dd></div>
          <div><dt>Depuis</dt><dd>Maroc, travail à distance</dd></div>
          <div><dt>Zones</dt><dd>Maroc, France, Belgique, Suisse, Canada</dd></div>
          <div><dt>Entrée</dt><dd>Audit marketing et digital</dd></div>
          <div><dt>Modèle</dt><dd>Forfait sur périmètre écrit</dd></div>
          <div><dt>Propriété</dt><dd>Accès, code et données remis au client</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section wrap">
    <div class="split">
      <div class="reveal">
        <p class="section-label">Raison d’être</p>
        <h2>Les entreprises ne manquent pas d’outils. Elles manquent de <em>direction</em>.</h2>
      </div>
      <div class="reveal">
        <p class="lede">
          La plupart des PME que nous rencontrons ont déjà essayé quelque chose : un site refait,
          une campagne lancée, un community manager recruté, un outil d’emailing installé.
          L’activité est là. Ce qui manque, c’est une réponse claire à trois questions.
        </p>
        <p class="lede" style="margin-top:1rem">
          Qu’est-ce qui produit réellement des clients aujourd’hui ? Qu’est-ce qui coûte sans servir ?
          Et que faut-il faire ensuite, dans quel ordre ?
        </p>
        <p class="lede" style="margin-top:1rem">
          TalentDigital existe pour répondre à ces trois questions avant de vendre quoi que ce soit —
          puis pour exécuter, quand l’exécution est la bonne réponse.
        </p>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section__head reveal">
      <p class="section-label">Façon de travailler</p>
      <h2>Quatre engagements <em>vérifiables</em>.</h2>
      <p class="lede" style="margin-top:1rem">
        Pas de valeurs affichées au mur. Des engagements qui se voient dans le devis, dans le
        document livré et dans la façon dont une mission se termine.
      </p>
    </div>
    <div class="princ-grid">
      {principles.map((p) => (
        <article class="princ reveal">
          <span class="princ__no">{p.no}</span>
          <h3>{p.t}</h3>
          <p>{p.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="section__head reveal">
      <p class="section-label">Statut assumé</p>
      <h2>Ce que nous sommes, exactement.</h2>
    </div>
    <div class="status-grid">
      <div class="status-card reveal">
        <h3>Activité indépendante</h3>
        <p>
          TalentDigital n’est pas une agence avec une équipe salariée et un plateau de production.
          C’est une structure indépendante : la personne qui vous conseille est celle qui exécute.
          Cette taille a un avantage — pas d’intermédiaire, pas de dossier transmis à un exécutant
          anonyme — et une limite : nous ne prenons pas dix projets simultanés.
        </p>
      </div>
      <div class="status-card reveal">
        <h3>Pas de société immatriculée à ce jour</h3>
        <p>
          TalentDigital exerce à titre indépendant et n’est pas, à la date de cette page,
          immatriculé comme société. Cette mention est publiée volontairement : vous devez savoir
          à qui vous parlez et dans quel cadre. La page sera mise à jour dès qu’une structure
          juridique sera enregistrée.
        </p>
      </div>
      <div class="status-card reveal">
        <h3>Partenaires ponctuels</h3>
        <p>
          Sur certains projets techniques — développement applicatif lourd, production vidéo,
          photographie — un partenaire peut intervenir. Il est nommé dans le devis, intervient sous
          notre responsabilité, et vous en êtes informé avant le démarrage. Jamais l’inverse.
        </p>
      </div>
      <div class="status-card reveal">
        <h3>Aucune promesse de résultat chiffré</h3>
        <p>
          Nous nous engageons sur la méthode, le périmètre, les livrables et le calendrier de
          production. Nous ne nous engageons pas sur un nombre de leads, une position Google ou un
          chiffre d’affaires. Ce n’est pas de la prudence excessive : c’est la seule promesse honnête.
        </p>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section__head reveal">
      <p class="section-label">Ce que nous refusons</p>
      <h2>Cinq choses que vous ne nous verrez pas <em>faire</em>.</h2>
    </div>
    <div class="refuse-list">
      {refused.map((r) => (
        <div class="refuse-row reveal">
          <span class="refuse-row__mark" aria-hidden="true">×</span>
          <div>
            <h3>{r.t}</h3>
            <p>{r.d}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="split">
      <div class="reveal">
        <p class="section-label">Rémunération</p>
        <h2>Comment nous sommes <em>payés</em>.</h2>
        <p class="lede" style="margin-top:1rem">
          Un forfait pour un périmètre, annoncé avant le démarrage. Pas de pourcentage sur votre
          budget publicitaire : ce montage pousse mécaniquement à vous faire dépenser plus.
        </p>
        <p class="lede" style="margin-top:1rem">
          Quand une mission s’étale dans le temps, un échelonnement mensuel peut être prévu au devis.
          Le montant total reste connu à l’avance.
        </p>
      </div>
      <div class="pay-card reveal">
        <p class="pay-card__h">Structure type</p>
        <ul>
          <li><b>Audit</b> — forfait, périmètre et durée écrits.</li>
          <li><b>Conseil</b> — forfait par mission ou échelonnement mensuel.</li>
          <li><b>Exécution</b> — forfait par livrable, devis séparé.</li>
          <li><b>Budget média</b> — payé directement à la régie, jamais via nous.</li>
          <li><b>Outils et abonnements</b> — à votre nom, hors devis.</li>
        </ul>
        <p class="pay-card__note">
          Aucun tarif ferme n’est publié sans périmètre défini. Les fourchettes sont données
          après le premier échange.
        </p>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section__head reveal">
      <p class="section-label">Périmètre</p>
      <h2>Les engagements, et les <em>refus</em>.</h2>
    </div>
    <div class="scope-grid">
      <div class="scope-col scope-col--yes reveal">
        <h3>Nos engagements</h3>
        <ul class="scope-list">
          {scopes.yes.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="scope-col scope-col--no reveal">
        <h3>Ce que nous refusons</h3>
        <ul class="scope-list">
          {scopes.no.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="faq-split">
      <div class="reveal">
        <p class="section-label">Questions</p>
        <h2>Ce que les gens veulent savoir avant de <em>s’engager</em>.</h2>
      </div>
      <Faq items={faq} idPrefix="apropos-faq" />
    </div>
  </section>

  <Cta
    title="Si cette façon de travailler vous <em>parle</em>."
    text="Un échange de trente minutes suffit pour voir si la collaboration a du sens. Si ce n’est pas le cas, nous vous le dirons — et vous n’aurez rien perdu."
    primaryLabel="Discutons de votre projet"
    primaryHref="/contact"
    secondaryLabel="Voir la méthode"
    secondaryHref="/methode"
  />

  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</BaseLayout>

<style>
  .page-hero{padding-top:clamp(2rem,4vw,3rem);padding-bottom:clamp(3rem,7vw,5rem);border-bottom:1px solid var(--line)}
  .page-hero__grid{margin-top:1.6rem}

  .fact-card{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:1.6rem}
  .fact-card__h{font-family:var(--mono);font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--lime)}
  .fact-list{margin-top:1rem;display:flex;flex-direction:column}
  .fact-list > div{display:flex;justify-content:space-between;gap:1rem;padding:.7rem 0;border-top:1px solid var(--line)}
  .fact-list dt{font-family:var(--mono);font-size:.68rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);flex:none}
  .fact-list dd{font-size:.84rem;color:var(--txt);text-align:right;line-height:1.45}

  .princ-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.2rem}
  .princ{border-top:1px solid var(--line-2);padding-top:1.1rem}
  .princ__no{font-family:var(--mono);font-size:.7rem;color:var(--lime);letter-spacing:.1em}
  .princ h3{font-size:1.05rem;font-weight:800;letter-spacing:-.01em;margin-top:.6rem;line-height:1.35}
  .princ p{font-size:.88rem;color:var(--muted);line-height:1.62;margin-top:.55rem}

  .status-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}
  .status-card{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:1.6rem}
  .status-card h3{font-size:1.02rem;font-weight:800;letter-spacing:-.01em;color:var(--lime)}
  .status-card p{font-size:.88rem;color:var(--muted);line-height:1.65;margin-top:.7rem}

  .refuse-list{display:flex;flex-direction:column;border-top:1px solid var(--line-2)}
  .refuse-row{display:flex;gap:1.1rem;padding:1.3rem 0;border-bottom:1px solid var(--line)}
  .refuse-row__mark{font-family:var(--mono);font-size:1.1rem;font-weight:700;color:var(--danger);line-height:1.2;flex:none}
  .refuse-row h3{font-size:1rem;font-weight:800;letter-spacing:-.01em}
  .refuse-row p{font-size:.88rem;color:var(--muted);line-height:1.6;margin-top:.35rem}

  .pay-card{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:1.6rem}
  .pay-card__h{font-family:var(--mono);font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--lime)}
  .pay-card ul{list-style:none;margin-top:1.1rem;display:flex;flex-direction:column;gap:.75rem}
  .pay-card li{font-size:.88rem;color:var(--muted);line-height:1.55;padding-left:1.2rem;position:relative}
  .pay-card li::before{content:"—";position:absolute;left:0;color:var(--lime);font-family:var(--mono)}
  .pay-card li b{color:var(--txt);font-weight:600}
  .pay-card__note{margin-top:1.2rem;padding-top:1rem;border-top:1px dashed var(--line);font-family:var(--mono);font-size:.7rem;line-height:1.55;color:var(--muted)}

  .faq-split{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(2rem,5vw,4.5rem);align-items:start}

  @media (max-width:960px){.faq-split{grid-template-columns:1fr}}
  @media (max-width:720px){
    .princ-grid,.status-grid{grid-template-columns:1fr}
    .fact-list > div{flex-direction:column;gap:.25rem}
    .fact-list dd{text-align:left}
  }
</style>
