---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Hero3D from '../components/Hero3D.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import { site } from '../data/site';

const whenYes = [
  { t: 'Un besoin interne qu’aucun outil ne couvre', d: 'Un processus spécifique à votre métier : devis, suivi de dossiers, calculs, tableaux de bord. Les outils génériques demandent plus d’adaptation que de développement.' },
  { t: 'Un produit numérique à lancer', d: 'Une plateforme, un espace client, un outil en ligne. Il faut une première version utilisable, pas une architecture complète dès le premier jour.' },
  { t: 'Un script ou un calcul répétitif', d: 'Une tâche manuelle qui prend deux heures par semaine et qui peut être automatisée. Le gain se mesure en heures, pas en fonctionnalités.' },
  { t: 'Une intégration entre deux outils', d: 'Deux logiciels qui ne se parlent pas, et une saisie manuelle entre les deux. Une passerelle bien faite supprime l’erreur humaine.' },
];

const included = [
  { n: '01', t: 'Cadrage fonctionnel', d: 'Un document qui liste les fonctions retenues, celles écartées et pourquoi. Le périmètre de la première version est volontairement réduit.' },
  { n: '02', t: 'Architecture et choix techniques', d: 'Langage, base de données, hébergement, dépendances. Chaque choix est justifié, avec ses conséquences en coût et en maintenance.' },
  { n: '03', t: 'Développement de la première version', d: 'Les fonctions indispensables, testées sur des cas réels. Pas de fonctionnalité « au cas où » qui alourdit la livraison.' },
  { n: '04', t: 'Tests et mise en production', d: 'Scénarios d’usage, gestion des erreurs, sauvegardes, environnement de test séparé avant la mise en ligne.' },
  { n: '05', t: 'Documentation technique', d: 'Schéma de la base, description des modules, procédure de déploiement, points de vigilance. Lisible par un autre développeur.' },
  { n: '06', t: 'Transfert du code et des accès', d: 'Dépôt de code, serveurs, comptes : tout est remis à votre nom. Aucune dépendance technique ne vous retient.' },
];

const notIncluded = [
  'Design d’interface avancé au-delà des écrans du périmètre',
  'Applications mobiles natives (iOS / Android)',
  'Hébergement, base de données et services tiers (facturés à votre nom)',
  'Maintenance et évolutions après la période de garantie',
  'Audit de sécurité approfondi ou certification',
  'Reprise d’un code existant sans phase d’audit préalable',
];

const rules = [
  { t: 'Une version utilisable d’abord', d: 'On livre un périmètre réduit qui fonctionne, puis on itère sur l’usage réel. Une première version trop large arrive tard et ne correspond jamais à l’usage.' },
  { t: 'Le périmètre est écrit', d: 'Chaque fonctionnalité est listée. Une demande hors périmètre devient un avenant chiffré, jamais une rallonge silencieuse.' },
  { t: 'Vos données restent vos données', d: 'Base de données à votre nom, export possible à tout moment, aucune donnée exploitée par nous à d’autres fins.' },
  { t: 'La maintenance est une option', d: 'Elle n’est pas une condition de livraison. Si vous avez une équipe technique, elle reprend le code avec la documentation.' },
];

const faq = [
  {
    q: 'Combien coûte un outil sur mesure ?',
    a: 'Cela dépend entièrement du périmètre fonctionnel. Un script d’automatisation et une plateforme multi-utilisateurs n’ont pas le même ordre de grandeur. Le devis est établi après le cadrage fonctionnel, avec un découpage en lots si le projet est important.',
  },
  {
    q: 'Pourquoi ne pas utiliser un outil existant ?',
    a: 'C’est la première question que nous posons. Si un outil du marché couvre 80 % du besoin à un coût raisonnable, nous le recommandons. Développer sur mesure se justifie quand l’écart avec l’existant est structurel, pas cosmétique.',
  },
  {
    q: 'Qui maintient l’outil ensuite ?',
    a: 'Trois options : vous reprenez avec votre équipe, vous nous confiez la maintenance par un contrat séparé, ou vous confiez le code à un autre prestataire. La documentation est écrite pour rendre cette troisième option possible sans friction.',
  },
  {
    q: 'Livrez-vous le code source ?',
    a: 'Oui, systématiquement, à la livraison, avec les accès au dépôt. Ce n’est pas une option payante. Un outil dont vous ne pouvez pas récupérer le code n’est pas un actif qui vous appartient.',
  },
  {
    q: 'Combien de temps pour une première version ?',
    a: 'Le délai est inscrit au devis et dépend du périmètre. Un outil interne simple et une plateforme multi-utilisateurs n’ont pas le même calendrier. Nous ne promettons pas de délai avant d’avoir écrit le périmètre.',
  },
  {
    q: 'Que se passe-t-il si le projet dérive ?',
    a: 'Le découpage en lots limite le risque : chaque lot est validé avant le suivant, et le budget du lot suivant n’est engagé qu’à ce moment. Si le besoin change, le périmètre est réécrit, pas subi.',
  },
];

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'SaaS et outils sur mesure',
  serviceType: 'Développement d’application sur mesure',
  description:
    'Développement d’outils sur mesure et de SaaS : cadrage fonctionnel, architecture, première version utilisable, tests, documentation et transfert du code.',
  url: `${site.domain}/saas`,
  provider: { '@id': `${site.domain}/#organization` },
  areaServed: site.areas,
};
---

<BaseLayout
  title="SaaS et outils sur mesure"
  description="Développement d’outils sur mesure et de SaaS : cadrage fonctionnel, architecture, première version utilisable, tests, documentation et transfert du code source."
>
  <section class="page-hero wrap">
    <Breadcrumbs items={[{ label: 'Solutions digitales', href: '/solutions-digitales' }, { label: 'SaaS sur mesure' }]} />
    <div class="split page-hero__grid">
      <div class="hero-copy">
        <span class="eyebrow">Solution 04 — SaaS et outils</span>
        <h1 class="display-1 reveal" style="margin-top:1rem">Construire l’outil qui manque, sans construire <em>trop</em>.</h1>
        <p class="lede reveal" style="margin-top:1.5rem;max-width:50ch">
          Une première version réduite, qui fonctionne sur des cas réels, puis des itérations
          décidées sur l’usage. Pas l’inverse : une plateforme complète livrée tard et mal utilisée.
        </p>
        <div class="hero-actions reveal">
          <a href="/contact" class="btn">Discutons de votre projet
            <svg class="arr" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/methode" class="btn btn--ghost">Voir la méthode</a>
        </div>
        <p class="note" style="margin-top:1.2rem">Périmètre découpé en lots · Code source transféré · Documentation lisible par un tiers</p>
      </div>

      <div class="hero-visual reveal">
        <Hero3D variant="cube" />
      </div>

      <aside class="side-note reveal">
        <p class="side-note__h">La première question</p>
        <p>
          Existe-t-il déjà un outil qui couvre 80 % du besoin ? Si oui, nous le recommandons.
          Développer sur mesure se justifie quand l’écart est structurel, pas cosmétique.
        </p>
        <a href="/consulting-marketing" class="side-note__link">Voir le pôle conseil →</a>
      </aside>
    </div>
  </section>

  <section class="section wrap">
    <div class="section__head reveal">
      <p class="section-label">Pour qui</p>
      <h2>Quatre cas où le sur-mesure se <em>justifie</em>.</h2>
    </div>
    <div class="two-grid">
      {whenYes.map((w) => (
        <article class="mini-card reveal">
          <h3>{w.t}</h3>
          <p>{w.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="section__head reveal">
      <p class="section-label">Ce qui est inclus</p>
      <h2>Six livrables, du cadrage au <em>transfert</em>.</h2>
    </div>
    <div class="deliver-grid reveal">
      {included.map((item) => (
        <article class="deliver-item">
          <p class="deliver-item__no">{item.n} — inclus</p>
          <h4>{item.t}</h4>
          <p>{item.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="split">
      <div class="reveal">
        <p class="section-label">Règles du jeu</p>
        <h2>Quatre principes qui évitent les projets <em>interminables</em>.</h2>
        <p class="lede" style="margin-top:1rem">
          Un projet technique dérape rarement à cause du code. Il dérape à cause d’un périmètre
          qui grandit sans décision explicite.
        </p>
      </div>
      <div class="steps-list">
        {rules.map((r, i) => (
          <div class="step-row reveal">
            <span class="step-row__n">{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{r.t}</h3><p>{r.d}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="split">
      <div class="reveal">
        <p class="section-label">Transparence</p>
        <h2>Ce qui n’est pas dans le <em>devis</em>.</h2>
      </div>
      <div class="not-list reveal">
        <ul>
          {notIncluded.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="faq-split">
      <div class="reveal">
        <p class="section-label">Questions</p>
        <h2>Ce qu’on nous demande sur le <em>sur-mesure</em>.</h2>
      </div>
      <Faq items={faq} idPrefix="saas-faq" />
    </div>
  </section>

  <Cta
    title="Un outil à construire ? Commençons par le <em>cadrer</em>."
    text="Décrivez le besoin en quelques lignes : ce que vous faites aujourd’hui à la main, et ce que l’outil devrait remplacer. Nous dirons si un outil existant suffit."
    primaryLabel="Discutons de votre projet"
    primaryHref="/contact"
    secondaryLabel="Voir la méthode"
    secondaryHref="/methode"
  />

  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</BaseLayout>
