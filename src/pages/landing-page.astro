---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import { site } from '../data/site';

const anatomy = [
  { n: '01', t: 'La promesse, en haut de page', d: 'En trois secondes, le visiteur doit savoir ce que vous proposez, à qui, et ce qu’il gagne. Pas de slogan abstrait, pas de « bienvenue sur notre site ».' },
  { n: '02', t: 'Le problème, formulé avec ses mots', d: 'On reformule la situation du visiteur avant de présenter la solution. S’il ne se reconnaît pas, il partira avant la deuxième section.' },
  { n: '03', t: 'La preuve', d: 'Méthode publiée, livrables nommés, exemples de travail, statut clair. Une affirmation sans preuve ne convainc personne — et un témoignage inventé détruit la confiance quand il est découvert.' },
  { n: '04', t: 'L’offre, sans zone d’ombre', d: 'Ce qui est inclus, ce qui ne l’est pas, ce que ça coûte ou comment le prix se détermine, et sous quel délai.' },
  { n: '05', t: 'Les objections, traitées explicitement', d: '« C’est trop cher », « je n’ai pas le temps », « je ne suis pas sûr que ça marche pour moi ». Chaque objection prévisible a sa réponse sur la page.' },
  { n: '06', t: 'Un seul appel à l’action, répété', d: 'Un objectif par page. Le même bouton, plusieurs fois, avec le même libellé. Deux appels concurrents divisent le résultat.' },
];

const included = [
  { n: '01', t: 'Structure argumentative', d: 'Un plan de page construit sur la logique de décision du visiteur, pas sur l’ordre habituel des sites d’entreprise.' },
  { n: '02', t: 'Rédaction', d: 'Textes rédigés pour cette offre précise : titres, sections, objections, appels à l’action. Pas de texte générique recyclé.' },
  { n: '03', t: 'Design et intégration responsive', d: 'Mise en page conçue pour la lecture mobile, hiérarchie visuelle claire, contraste vérifié. Rapide à charger.' },
  { n: '04', t: 'Formulaire et suivi des conversions', d: 'Formulaire court, messages d’erreur lisibles, événement de conversion configuré, avec consentement pour la mesure.' },
  { n: '05', t: 'Version de test', d: 'Une variante du titre ou de l’appel à l’action, prête à être comparée, avec la méthode de lecture des résultats.' },
  { n: '06', t: 'Documentation', d: 'Où modifier un texte, comment dupliquer la page pour une autre offre, comment lire les conversions.' },
];

const whenYes = [
  { t: 'Vous lancez une campagne', d: 'Une page dédiée convertit mieux qu’une page d’accueil générique : le message correspond exactement à l’annonce qui a amené le visiteur.' },
  { t: 'Votre page actuelle ne convertit pas', d: 'Le trafic est là, les demandes ne suivent pas. La page est souvent le maillon faible, et c’est le moins coûteux à corriger.' },
  { t: 'Vous testez une nouvelle offre', d: 'Avant de construire un site complet, une page unique permet de valider la promesse, le prix et les objections réelles.' },
  { t: 'Vous vendez un service à forte valeur', d: 'Un parcours plus long qu’un simple formulaire : présentation de l’offre, traitement des objections, prise de rendez-vous.' },
];

const notIncluded = [
  'Budget publicitaire et frais de régie',
  'Trafic : la page ne génère pas de visiteurs par elle-même',
  'Production photo, vidéo ou illustration originale',
  'Rédaction de contenus au-delà de la page',
  'Abonnements outils (emailing, prise de rendez-vous, paiement)',
  'Tests A/B sur une longue période : la variante est livrée, l’exploitation est distincte',
];

const faq = [
  {
    q: 'Une landing page peut-elle vraiment augmenter les conversions ?',
    a: 'Elle peut réduire les frictions et aligner le message sur l’intention du visiteur. C’est ce qui produit une amélioration — quand le problème est bien celui-là. Si l’offre n’intéresse personne ou si le trafic est mal ciblé, une page ne corrige ni l’un ni l’autre.',
  },
  {
    q: 'Combien de sections faut-il ?',
    a: 'Autant que nécessaire pour lever les objections réelles, pas plus. Une page de six sections bien construites convertit souvent mieux qu’une page de vingt sections qui dilue la promesse. La structure se décide après avoir compris l’offre et le visiteur.',
  },
  {
    q: 'Faut-il un témoignage client sur la page ?',
    a: 'Un vrai témoignage, avec accord écrit, aide. Un faux témoignage est un risque juridique et un risque de réputation. S’il n’y a pas de témoignage disponible, on compense avec des preuves vérifiables : méthode, livrables, exemples de travail, statut.',
  },
  {
    q: 'Puis-je réutiliser la page pour plusieurs offres ?',
    a: 'La structure et le design peuvent être dupliqués, mais le contenu doit être réécrit pour chaque offre. Une page « toutes offres » dilue le message et convertit moins bien qu’une page par offre. La duplication technique est incluse dans la documentation.',
  },
  {
    q: 'Combien de temps pour livrer ?',
    a: 'Le délai est inscrit au devis et dépend surtout de la disponibilité des éléments : offre définie, preuves disponibles, décisions prises. Une page dont l’offre change en cours de route prend plus de temps qu’annoncé, quelle que soit la vitesse de production.',
  },
  {
    q: 'Faut-il passer par un audit avant ?',
    a: 'Si votre offre est claire, votre cible connue et que vous savez quelle objection traiter, nous pouvons travailler directement. Si l’offre elle-même n’est pas stabilisée, un cadrage préalable évite de construire une page sur une promesse qui va changer.',
  },
];

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Landing pages et pages de vente',
  serviceType: 'Création de landing page',
  description:
    'Conception de landing pages et pages de vente : structure argumentative, rédaction, design responsive, formulaire, suivi des conversions et documentation.',
  url: `${site.domain}/landing-page`,
  provider: { '@type': 'Organization', name: site.name, url: site.domain },
  areaServed: site.areas,
};
---

<BaseLayout
  title="Landing page et page de vente — une page, un objectif"
  description="Landing pages conçues pour une offre précise : structure argumentative, rédaction, objections traitées, formulaire et suivi des conversions. Une page, un objectif, un seul appel à l’action."
>
  <section class="page-hero wrap">
    <Breadcrumbs items={[{ label: 'Solutions digitales', href: '/solutions-digitales' }, { label: 'Landing page' }]} />
    <div class="split page-hero__grid">
      <div>
        <span class="eyebrow">Solution 02 — Landing page</span>
        <h1 class="display-1 reveal" style="margin-top:1rem">Une page, un objectif, un seul <em>appel à l’action</em>.</h1>
        <p class="lede reveal" style="margin-top:1.5rem;max-width:50ch">
          Une landing page ne raconte pas toute votre entreprise. Elle traite une offre précise,
          pour un visiteur précis, et le conduit à une action unique.
        </p>
        <div class="hero-actions reveal">
          <a href="/contact" class="btn">Discutons de votre projet
            <svg class="arr" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/audit-tunnel" class="btn btn--ghost">Diagnostiquer ma page</a>
        </div>
        <p class="note" style="margin-top:1.2rem">Une seule action par page · Mesure des conversions incluse · Variante de test livrée</p>
      </div>

      <aside class="side-note reveal">
        <p class="side-note__h">Le test le plus simple</p>
        <p>
          Cachez le nom de votre entreprise sur votre page actuelle. Si elle pourrait appartenir
          à n’importe quel concurrent, le problème n’est pas le design : c’est le message.
        </p>
        <a href="/audit-tunnel" class="side-note__link">Faire le diagnostic →</a>
      </aside>
    </div>
  </section>

  <section class="section wrap">
    <div class="section__head reveal">
      <p class="section-label">Anatomie</p>
      <h2>Les six blocs qui déterminent le <em>résultat</em>.</h2>
      <p class="lede" style="margin-top:1rem">
        Le design rend ces blocs lisibles. Il ne les remplace pas. Une page sans promesse claire
        reste une page qui ne convertit pas, même très bien dessinée.
      </p>
    </div>
    <div class="three-grid">
      {anatomy.map((a) => (
        <article class="mini-card reveal">
          <span class="note" style="color:var(--lime)">{a.n}</span>
          <h3 style="margin-top:.5rem">{a.t}</h3>
          <p>{a.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="section__head reveal">
      <p class="section-label">Pour qui</p>
      <h2>Quand une page dédiée est le bon <em>investissement</em>.</h2>
    </div>
    <div class="two-grid">
      {whenYes.map((w) => (
        <article class="mini-card reveal">
          <h3>{w.t}</h3>
          <p>{w.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="section__head reveal">
      <p class="section-label">Ce qui est inclus</p>
      <h2>Six livrables, du plan de page à la <em>documentation</em>.</h2>
    </div>
    <div class="deliver-grid reveal">
      {included.map((item) => (
        <article class="deliver-item">
          <p class="deliver-item__no">{item.n} — inclus</p>
          <h4>{item.t}</h4>
          <p>{item.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="split">
      <div class="reveal">
        <p class="section-label">Transparence</p>
        <h2>Une page ne remplace pas le <em>trafic</em>.</h2>
        <p class="lede" style="margin-top:1rem">
          C’est la confusion la plus fréquente : une landing page ne fait pas venir de visiteurs.
          Elle transforme ceux qui arrivent. Sans source de trafic, elle reste vide.
        </p>
      </div>
      <div class="not-list reveal">
        <ul>
          {notIncluded.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="split">
      <div class="reveal">
        <p class="section-label">Déroulé</p>
        <h2>Cinq étapes, aucune maquette avant le <em>message</em>.</h2>
      </div>
      <div class="steps-list">
        <div class="step-row reveal">
          <span class="step-row__n">01</span>
          <div><h3>Cadrage de l’offre</h3><p>À qui s’adresse la page, quelle action est attendue, quelles objections doivent être levées. Écrit avant toute maquette.</p></div>
        </div>
        <div class="step-row reveal">
          <span class="step-row__n">02</span>
          <div><h3>Plan de page</h3><p>L’ordre des sections et l’argument de chacune. Validé avant rédaction, pour éviter de réécrire trois fois.</p></div>
        </div>
        <div class="step-row reveal">
          <span class="step-row__n">03</span>
          <div><h3>Rédaction</h3><p>Titres, corps de texte, objections, appels à l’action. Relu pour la clarté et la cohérence avec l’offre réelle.</p></div>
        </div>
        <div class="step-row reveal">
          <span class="step-row__n">04</span>
          <div><h3>Design et intégration</h3><p>Mise en page, responsive, performances, formulaire, suivi des conversions avec consentement.</p></div>
        </div>
        <div class="step-row reveal">
          <span class="step-row__n">05</span>
          <div><h3>Mise en ligne et lecture</h3><p>Vérification du parcours, événement de conversion, documentation. Puis lecture des premiers résultats et décision.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="faq-split">
      <div class="reveal">
        <p class="section-label">Questions</p>
        <h2>Ce qu’on nous demande sur les <em>pages</em>.</h2>
      </div>
      <Faq items={faq} idPrefix="lp-faq" />
    </div>
  </section>

  <Cta
    title="Une offre à présenter, une page à <em>construire</em>."
    text="Décrivez l’offre et l’action attendue. Nous revenons avec les questions à trancher avant de rédiger — pas une maquette envoyée au hasard."
    primaryLabel="Discutons de votre projet"
    primaryHref="/contact"
    secondaryLabel="Diagnostic tunnel gratuit"
    secondaryHref="/audit-tunnel"
  />

  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</BaseLayout>
