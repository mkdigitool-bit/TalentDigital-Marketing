---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';

const axes = [
  {
    n: '01',
    t: 'Offre et message',
    d: 'Ce que vous vendez exactement, à qui, à quel prix, et si un visiteur comprend la promesse en quelques secondes. C’est le point de départ : sans offre claire, aucun canal ne rattrape le problème.',
  },
  {
    n: '02',
    t: 'Canaux et acquisition',
    d: 'D’où viennent les demandes aujourd’hui : bouche-à-oreille, recherche, publicité, réseaux. Ce qui est payé, ce qui est organique, et ce qui n’est mesuré par personne.',
  },
  {
    n: '03',
    t: 'Parcours et conversion',
    d: 'De l’arrivée au formulaire ou à la commande. Où les visiteurs s’arrêtent, quelle page ils quittent, et ce qui les fait partir — sur mobile d’abord.',
  },
  {
    n: '04',
    t: 'Mesure et données',
    d: 'Ce qui est suivi, avec quel outil, avec quel consentement, et ce qui manque pour décider. Un dispositif sans mesure ne se pilote pas.',
  },
  {
    n: '05',
    t: 'Concurrence et marché',
    d: 'À qui vous êtes comparé, sur quels arguments, à quel niveau de prix. La lecture sert à situer votre discours, pas à copier celui des autres.',
  },
  {
    n: '06',
    t: 'Capacité d’exécution',
    d: 'Ce que vous pouvez produire en interne, à quel rythme, et ce qui dépend d’un prestataire. Un plan que vous ne pouvez pas exécuter ne sert à rien.',
  },
];

const deliverables = [
  {
    n: '01',
    t: 'Document d’audit écrit',
    d: 'Constats reliés à une preuve : donnée, capture, citation d’entretien, document. Aucun constat invérifiable.',
  },
  {
    n: '02',
    t: 'Cartographie du parcours',
    d: 'Chaque étape, son rôle, son point d’abandon probable et la correction correspondante.',
  },
  {
    n: '03',
    t: 'Tableau des canaux',
    d: 'Canal, rôle, coût actuel, indicateur à suivre, et critère d’arrêt si le canal ne produit pas.',
  },
  {
    n: '04',
    t: 'Plan d’action priorisé',
    d: 'Chaque chantier classé par impact attendu et effort nécessaire, avec un responsable et un budget indicatif.',
  },
  {
    n: '05',
    t: 'Restitution commentée',
    d: 'Une réunion pour parcourir le document, discuter les points contestés et corriger ce qui doit l’être.',
  },
  {
    n: '06',
    t: 'Le document vous appartient',
    d: 'Il est écrit pour être exécuté sans nous si vous le souhaitez. Aucune partie n’est retenue en otage.',
  },
];

const steps = [
  {
    n: '01',
    t: 'Premier échange — 30 minutes',
    d: 'Vous décrivez votre activité et ce qui bloque. Nous posons les questions qui permettent de dire si un audit est utile — ou si la réponse est ailleurs.',
  },
  {
    n: '02',
    t: 'Cadrage et accès',
    d: 'Le périmètre est écrit : ce qui est analysé, ce qui ne l’est pas, la décision que l’audit doit permettre de prendre. Accès en lecture aux données disponibles.',
  },
  {
    n: '03',
    t: 'Analyse',
    d: 'Revue des canaux, du parcours et de la concurrence, complétée par un entretien. Chaque constat est documenté au moment où il est fait.',
  },
  {
    n: '04',
    t: 'Restitution et décision',
    d: 'Le document est présenté, discuté, ajusté. Vous repartez avec un plan classé par priorité — et une décision prise, pas une liste de recommandations.',
  },
];

const limits = [
  'Un rapport de soixante pages que personne ne lit',
  'Un prétexte pour vendre une refonte de site',
  'Une promesse de nombre de leads ou de position Google',
  'Un avis général sur votre marché, sans preuve',
  'Une recommandation que nous ne pourrions pas expliquer',
];

const services = [
  { value: 'audit', label: 'Audit marketing et digital' },
  { value: 'consulting', label: 'Consulting marketing ou positionnement' },
  { value: 'marketing', label: 'Marketing digital — SEO, publicité, contenu' },
  { value: 'site-web', label: 'Site web ou e-commerce' },
  { value: 'landing', label: 'Landing page ou page de vente' },
  { value: 'tunnel', label: 'Tunnel de vente' },
  { value: 'saas', label: 'SaaS ou outil sur mesure' },
  { value: 'autre', label: 'Je ne sais pas encore' },
];

const budgets = [
  { value: 'non-defini', label: 'Pas encore défini' },
  { value: '<500', label: 'Moins de 500 €' },
  { value: '500-1500', label: '500 – 1 500 €' },
  { value: '1500-3000', label: '1 500 – 3 000 €' },
  { value: '>3000', label: 'Plus de 3 000 €' },
];

const faq = [
  {
    q: 'L’audit est-il payant ?',
    a: 'L’audit est une mission facturée au forfait : c’est un travail d’analyse et de rédaction, pas un appel commercial déguisé. Le premier échange de trente minutes, lui, est gratuit et sans document à produire. Le montant de l’audit est annoncé avant le démarrage.',
  },
  {
    q: 'Pourquoi ne pas donner un devis dès le premier message ?',
    a: 'Parce qu’un devis sans périmètre est un chiffre inventé. Le prix d’un site, d’un tunnel ou d’une mission de conseil dépend du nombre de pages, du niveau de rédaction, des intégrations et du calendrier. Ces éléments se décident après avoir compris la situation.',
  },
  {
    q: 'Que se passe-t-il si l’audit conclut qu’il ne faut rien changer ?',
    a: 'Nous l’écrivons. Un audit qui conclut « le dispositif actuel est cohérent, corrigez trois points » est un résultat valable. Il coûte toujours moins cher qu’un projet lancé pour occuper un budget.',
  },
  {
    q: 'Combien de temps prend un audit ?',
    a: 'Un audit standard prend généralement deux à trois semaines à partir du moment où les accès et les documents sont disponibles. C’est un ordre de grandeur, pas un engagement : le calendrier dépend du périmètre et de la réactivité des échanges.',
  },
  {
    q: 'Faut-il nous engager à exécuter ensuite ?',
    a: 'Non. L’audit est une mission complète, et le plan est écrit pour être exécuté en interne. Si vous souhaitez ensuite une exécution, elle fait l’objet d’un devis séparé, sur un périmètre distinct.',
  },
  {
    q: 'Que faites-vous des données que vous consultez ?',
    a: 'Elles servent uniquement à l’analyse, ne sont ni revendues ni réutilisées pour un autre client, et les accès sont révoqués à la fin de la mission. Le détail figure dans la politique de confidentialité.',
  },
  {
    q: 'Travaillez-vous en dehors du Maroc ?',
    a: 'Oui. Le Maroc est le marché d’ancrage ; nous accompagnons aussi des clients en France, en Belgique, en Suisse et au Canada. Tout se fait à distance, avec des points de suivi fixés à l’avance.',
  },
  {
    q: 'Garantissez-vous un résultat ?',
    a: 'Non. Ce qui est garanti, c’est la méthode, le périmètre écrit, les livrables nommés et le fait que le document vous appartient. Un nombre de leads, une position Google ou un chiffre d’affaires ne dépendent pas entièrement de nous.',
  },
];

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Audit marketing et digital',
  serviceType: 'Audit marketing',
  description:
    'Audit marketing et digital : diagnostic écrit des canaux, du parcours, de la mesure et de la concurrence, suivi d’un plan d’action priorisé et d’une restitution commentée.',
  url: `${site.domain}/audit`,
  provider: { '@id': `${site.domain}/#organization` },
  areaServed: site.areas,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    description: 'Forfait défini après un premier échange, annoncé avant le démarrage de la mission.',
  },
};
---

<BaseLayout
  title="Audit marketing : ce qui produit, ce qui coûte"
  description="Un audit marketing qui sert à décider : constats sourcés, causes identifiées, canaux classés, plan d’action priorisé. Le document vous appartient."
>
  <section class="page-hero wrap">
    <Breadcrumbs items={[{ label: 'Audit marketing' }]} />
    <div class="split page-hero__grid">
      <div>
        <span class="eyebrow">Point d’entrée</span>
        <h1 class="display-1 reveal" style="margin-top:1rem">Avant de dépenser plus, savoir ce qui <em>produit déjà</em>.</h1>
        <p class="lede reveal" style="margin-top:1.5rem;max-width:52ch">
          Un audit marketing et digital répond à trois questions : ce qui amène des clients
          aujourd’hui, ce qui coûte sans servir, et ce qu’il faut faire ensuite — dans quel ordre.
        </p>
        <div class="hero-actions reveal">
          <a href="#demande" class="btn">Demander un audit
            <svg class="arr" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/methode" class="btn btn--ghost">Voir la méthode</a>
        </div>
        <p class="note reveal" style="margin-top:1.2rem">
          Premier échange de 30 min gratuit · Document écrit et restitué · Aucun engagement d’exécution
        </p>
      </div>

      <aside class="side-note reveal">
        <p class="side-note__h">Ce que l’audit n’est pas</p>
        <ul class="side-note__list">
          {limits.map((l) => <li>{l}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section wrap">
    <div class="section__head reveal">
      <p class="section-label">Périmètre</p>
      <h2>Six angles, une seule <em>question</em>.</h2>
      <p class="lede" style="margin-top:1rem">
        Chacun de ces angles est ouvert dans l’audit. Tous ne sont pas traités à la même profondeur :
        le périmètre écrit précise lesquels sont prioritaires pour votre situation.
      </p>
    </div>
    <div class="three-grid">
      {axes.map((a) => (
        <article class="mini-card reveal">
          <span class="mini-card__no">{a.n}</span>
          <h3>{a.t}</h3>
          <p>{a.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="section__head reveal">
      <p class="section-label">Livrables</p>
      <h2>Six choses concrètes que vous <em>gardez</em>.</h2>
      <p class="lede" style="margin-top:1rem">
        Un audit se juge à ce qu’il laisse derrière lui. Voici ce qui est remis, dans quel format,
        et à quoi cela sert.
      </p>
    </div>
    <div class="deliver-grid reveal">
      {deliverables.map((d) => (
        <article class="deliver-item">
          <p class="deliver-item__no">{d.n} — livrable</p>
          <h4>{d.t}</h4>
          <p>{d.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="split">
      <div class="reveal">
        <p class="section-label">Déroulé</p>
        <h2>Quatre étapes, du premier échange à la <em>décision</em>.</h2>
        <p class="lede" style="margin-top:1rem">
          Le calendrier dépend du périmètre et de la disponibilité des informations. Il est inscrit
          au devis, et il court à partir du moment où les accès sont réunis.
        </p>
      </div>
      <div class="steps-list">
        {steps.map((s) => (
          <div class="step-row reveal">
            <span class="step-row__n">{s.n}</span>
            <div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="split">
      <div class="reveal">
        <p class="section-label">Prix et cadre</p>
        <h2>Le prix est annoncé avant, jamais <em>après</em>.</h2>
        <p class="lede" style="margin-top:1rem">
          L’audit est facturé au forfait. Le montant est communiqué après le premier échange,
          une fois le périmètre écrit — parce qu’un prix sans périmètre est un chiffre inventé.
        </p>
        <p class="lede" style="margin-top:1rem">
          Les missions d’exécution qui suivent sont chiffrées à partir du périmètre validé, dans un
          devis distinct. Aucune rallonge n’est décidée en cours de route sans accord écrit.
        </p>
      </div>
      <div class="info-card reveal">
        <p class="info-card__h">Les règles</p>
        <ul>
          <li><b>Forfait</b> — pas de facturation à l’heure flottante.</li>
          <li><b>Montant connu avant le démarrage</b>, pas à la fin.</li>
          <li><b>Aucun pourcentage</b> sur votre budget publicitaire.</li>
          <li><b>Exécution séparée</b> — l’audit n’oblige à rien.</li>
          <li><b>Accès révoqués</b> à la fin de la mission.</li>
        </ul>
        <p class="info-card__note">
          Aucun tarif n’est affiché sans périmètre défini. Une fourchette est donnée dès le premier
          échange, avant tout engagement.
        </p>
      </div>
    </div>
  </section>

  <section class="section wrap" id="demande">
    <div class="section__head reveal">
      <p class="section-label">Demande</p>
      <h2>Décrivez votre situation, pas votre <em>cahier des charges</em>.</h2>
      <p class="lede" style="margin-top:1rem">
        Deux phrases suffisent : ce que vous faites, ce qui bloque, ce que vous avez déjà essayé.
        Les questions de cadrage viennent ensuite.
      </p>
    </div>

    <div class="form-grid">
      <div class="form-card reveal" id="td-contact-form">
        <div class="form-success" role="status" aria-live="polite">
          <div class="form-success__icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 14l6 6 12-12"/></svg>
          </div>
          <h2>Demande bien reçue.</h2>
          <p>Merci. Votre demande d’audit est enregistrée. Nous revenons vers vous sous 24 heures ouvrées, depuis l’adresse {site.email}.</p>
          <span class="form-success__tag">Réponse sous 24 h ouvrées</span>
        </div>

        <div class="form-fields">
          <h2 class="form-title">Demander un audit</h2>
          <p class="form-sub">
            Les champs marqués d’un astérisque sont nécessaires pour vous répondre. Aucun paiement
            n’est demandé à ce stade.
          </p>

          <form id="td-form" novalidate>
            <div class="hp-field" aria-hidden="true">
              <label for="td-website">Laissez ce champ vide</label>
              <input type="text" id="td-website" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <div class="form-row">
              <div class="field">
                <label for="td-prenom">Prénom <span class="req" aria-hidden="true">*</span></label>
                <input type="text" id="td-prenom" name="prenom" placeholder="Yassine" autocomplete="given-name" required />
              </div>
              <div class="field">
                <label for="td-nom">Nom <span class="req" aria-hidden="true">*</span></label>
                <input type="text" id="td-nom" name="nom" placeholder="Benali" autocomplete="family-name" required />
              </div>
            </div>

            <div class="form-row">
              <div class="field">
                <label for="td-email">Email <span class="req" aria-hidden="true">*</span></label>
                <input type="email" id="td-email" name="email" placeholder="vous@entreprise.com" autocomplete="email" required />
              </div>
              <div class="field">
                <label for="td-tel">Téléphone / WhatsApp</label>
                <input type="tel" id="td-tel" name="tel" placeholder="+212 6 XX XX XX XX" autocomplete="tel" />
              </div>
            </div>

            <div class="form-row">
              <div class="field">
                <label for="td-service">Ce qui vous amène <span class="req" aria-hidden="true">*</span></label>
                <select id="td-service" name="service" required>
                  <option value="" disabled selected>Choisissez un sujet</option>
                  {services.map((s) => <option value={s.value}>{s.label}</option>)}
                </select>
              </div>
              <div class="field">
                <label for="td-budget">Budget envisagé</label>
                <select id="td-budget" name="budget">
                  {budgets.map((b) => <option value={b.value}>{b.label}</option>)}
                </select>
              </div>
            </div>

            <div class="field">
              <label for="td-message">Votre situation <span class="req" aria-hidden="true">*</span></label>
              <textarea
                id="td-message"
                name="message"
                placeholder="Ex : PME de 12 personnes dans le BTP. Le site reçoit du trafic mais très peu de demandes. Une campagne Google Ads tourne depuis six mois sans suivi du coût par lead."
                required
              ></textarea>
              <p class="field__hint">Décrivez la situation en quelques lignes : ce qui bloque, ce que vous avez déjà essayé, et ce que vous attendez d’un audit.</p>
            </div>

            <div class="form-agree">
              <input type="checkbox" id="td-agree" name="agree" required />
              <p>
                J’accepte que ces informations soient utilisées pour préparer cet audit et me recontacter.
                <a href="/mentions-legales#confidentialite">Politique de confidentialité</a>
              </p>
            </div>

            <button type="submit" class="btn btn--full" id="td-submit">
              <span>Envoyer la demande</span>
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M1 8h14M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <p class="form-note">Aucune carte bancaire · Aucun engagement · Réponse sous 24 h ouvrées</p>
          </form>
        </div>
      </div>

      <aside class="form-aside reveal">
        <p class="side-note__h">Ce qui se passe ensuite</p>
        <div class="next-list">
          <div class="next-item">
            <span class="next-item__n">01</span>
            <div>
              <p class="next-item__t">Lecture du message</p>
              <p class="next-item__d">Nous lisons votre situation et vérifions qu’un audit est la bonne réponse — pas systématiquement.</p>
            </div>
          </div>
          <div class="next-item">
            <span class="next-item__n">02</span>
            <div>
              <p class="next-item__t">Échange de 30 minutes</p>
              <p class="next-item__d">Gratuit et sans document à produire. On cherche la question à traiter en priorité.</p>
            </div>
          </div>
          <div class="next-item">
            <span class="next-item__n">03</span>
            <div>
              <p class="next-item__t">Périmètre et prix</p>
              <p class="next-item__d">Si un audit a du sens, vous recevez un périmètre écrit et un forfait. Sinon, nous le disons.</p>
            </div>
          </div>
          <div class="next-item">
            <span class="next-item__n">04</span>
            <div>
              <p class="next-item__t">Décision</p>
              <p class="next-item__d">Vous validez, vous ajustez, ou vous exécutez seul avec les éléments déjà échangés.</p>
            </div>
          </div>
        </div>

        <div class="form-aside__foot">
          <p>Vous préférez écrire directement ?</p>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.whatsapp} target="_blank" rel="noopener">WhatsApp — {site.phoneDisplay}</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section wrap">
    <div class="faq-split">
      <div class="reveal">
        <p class="section-label">Questions</p>
        <h2>Ce qu’on nous demande avant de <em>commander</em>.</h2>
        <p class="lede" style="margin-top:1rem">
          Les réponses sont écrites ici, pas réservées à l’appel. Si une question manque, elle peut
          être posée par email — nous répondons.
        </p>
      </div>
      <Faq items={faq} idPrefix="audit-faq" />
    </div>
  </section>

  <Cta
    title="Un doute sur ce qu’il faut traiter <em>d’abord</em> ?"
    text="C’est exactement la question à laquelle un audit répond. Trente minutes suffisent pour voir si un diagnostic est utile — ou si la réponse est plus simple que prévu."
    primaryLabel="Demander un audit"
    primaryHref="#demande"
    secondaryLabel="Voir la méthode"
    secondaryHref="/methode"
  />

  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</BaseLayout>

<style>
  .page-hero{padding-top:clamp(2rem,4vw,3rem);padding-bottom:clamp(3rem,7vw,5rem);border-bottom:1px solid var(--line)}
  .page-hero__grid{margin-top:1.6rem}
  .hero-actions{display:flex;flex-wrap:wrap;gap:1rem;margin-top:2rem}

  .mini-card__no{display:block;font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;color:var(--accent);margin-bottom:.55rem}

  .form-grid{display:grid;grid-template-columns:1.45fr 1fr;gap:clamp(2rem,5vw,4rem);align-items:start}
  .field__hint{font-family:var(--mono);font-size:.68rem;color:var(--muted);line-height:1.5;margin-top:.1rem}

  .form-aside{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:1.6rem;position:sticky;top:96px}
  .next-list{display:flex;flex-direction:column;margin-top:1.1rem}
  .next-item{display:flex;gap:.9rem;padding:.95rem 0;border-top:1px solid var(--line)}
  .next-item__n{font-family:var(--mono);font-size:.7rem;color:var(--muted);padding-top:.15rem;flex:none}
  .next-item__t{font-size:.92rem;font-weight:700;color:var(--txt);line-height:1.35}
  .next-item__d{font-size:.82rem;color:var(--muted);line-height:1.55;margin-top:.3rem}
  .form-aside__foot{margin-top:1.2rem;padding-top:1rem;border-top:1px dashed var(--line);display:flex;flex-direction:column;gap:.3rem}
  .form-aside__foot p{font-size:.8rem;color:var(--muted)}
  .form-aside__foot a{font-family:var(--mono);font-size:.8rem;color:var(--accent);word-break:break-word}
  .form-aside__foot a + a{margin-top:.15rem}

  .faq-split{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(2rem,5vw,4.5rem);align-items:start}

  #demande{scroll-margin-top:90px}

  @media (max-width:960px){
    .form-grid,.faq-split{grid-template-columns:1fr}
    .form-aside{position:static}
  }
</style>

<script>
  (function () {
    const form = document.getElementById('td-form') as HTMLFormElement | null;
    const card = document.getElementById('td-contact-form');
    const submit = document.getElementById('td-submit') as HTMLButtonElement | null;
    if (!form || !card || !submit) return;

    const submitLabel = submit.innerHTML;

    // Premier contact avec le formulaire : sert à mesurer l'abandon en cours de saisie.
    let started = false;
    form.addEventListener(
      'focusin',
      () => {
        if (started) return;
        started = true;
        const w = window as unknown as { tdTrack?: (n: string, p?: Record<string, unknown>) => void };
        w.tdTrack?.('form_start', { form: 'audit' });
      },
      { once: true }
    );

    function clearErrors() {
      form!.querySelectorAll('.field-error').forEach((el) => el.remove());
      form!.querySelectorAll('.is-invalid').forEach((el) => el.classList.remove('is-invalid'));
      const prev = document.getElementById('td-form-error');
      if (prev) prev.remove();
    }

    function showError(msg: string) {
      const el = document.createElement('p');
      el.id = 'td-form-error';
      el.setAttribute('role', 'alert');
      el.className = 'field-error';
      el.style.marginTop = '1rem';
      el.style.textAlign = 'center';
      el.textContent = msg;
      submit!.insertAdjacentElement('afterend', el);
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      clearErrors();
      let valid = true;

      form.querySelectorAll<HTMLInputElement>('[required]').forEach((field) => {
        const empty = field.type === 'checkbox' ? !field.checked : !field.value.trim();
        if (!empty) return;
        valid = false;
        field.classList.add('is-invalid');
        const err = document.createElement('span');
        err.className = 'field-error';
        err.textContent =
          field.type === 'checkbox'
            ? 'Merci de cocher cette case pour continuer.'
            : 'Ce champ est nécessaire pour vous répondre.';
        (field.closest('.form-agree') || field.parentNode)!.appendChild(err);
      });

      if (!valid) {
        (form.querySelector('.is-invalid') as HTMLElement | null)?.focus();
        return;
      }

      const data = {
        prenom: (form.querySelector('#td-prenom') as HTMLInputElement).value.trim(),
        nom: (form.querySelector('#td-nom') as HTMLInputElement).value.trim(),
        email: (form.querySelector('#td-email') as HTMLInputElement).value.trim(),
        tel: (form.querySelector('#td-tel') as HTMLInputElement).value.trim(),
        service: (form.querySelector('#td-service') as HTMLSelectElement).value,
        budget: (form.querySelector('#td-budget') as HTMLSelectElement).value,
        message: (form.querySelector('#td-message') as HTMLTextAreaElement).value.trim(),
        website: (form.querySelector('#td-website') as HTMLInputElement).value,
      };

      submit!.disabled = true;
      submit!.style.opacity = '.6';
      submit!.textContent = 'Envoi en cours…';

      fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      })
        .then((res) => res.json().then((payload) => ({ ok: res.ok, payload })))
        .then((result) => {
          if (!result.ok || !result.payload.ok) {
            throw new Error(result.payload?.error || 'Une erreur est survenue.');
          }
          card!.classList.add('is-sent');
          card!.querySelector('.form-success')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          const w = window as unknown as { tdTrack?: (n: string, p?: Record<string, unknown>) => void };
          w.tdTrack?.('generate_lead', { form: 'audit', service: data.service });
        })
        .catch((err: Error) => {
          showError(err.message || 'Une erreur est survenue. Réessayez ou écrivez-nous à info@talentdigital.net.');
          submit!.disabled = false;
          submit!.style.opacity = '';
          submit!.innerHTML = submitLabel;
        });
    });

    form.querySelectorAll('input,textarea,select').forEach((field) => {
      field.addEventListener('input', () => {
        field.classList.remove('is-invalid');
        field.parentNode?.querySelector('.field-error')?.remove();
      });
    });
  })();
</script>
