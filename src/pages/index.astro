---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import {
  site,
  poles,
  method,
  deliverables,
  scopes,
  segments,
  faqHome,
} from '../data/site';

const offersLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Pôles d’intervention TalentDigital',
  itemListElement: poles.map((pole, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: pole.name,
      description: pole.desc,
      url: new URL(pole.href, site.domain).toString(),
      provider: { '@type': 'Organization', name: site.name, url: site.domain },
    },
  })),
};
---

<BaseLayout
  title="TalentDigital — Conseil marketing et solutions digitales pour PME"
  description="TalentDigital diagnostique votre marketing, définit une stratégie priorisée puis déploie les moyens adaptés : site, tunnel, SEO, publicité, email, automatisation. Maroc et international francophone."
  ogImage="/og-default.png"
>
  <section class="hero wrap">
    <div class="hero__grid">
      <div class="hero__main">
        <span class="eyebrow">Conseil marketing &amp; solutions digitales</span>
        <h1 class="display-1 reveal">
          Vous n’avez pas un problème d’outils. Vous avez un problème de <em>direction</em>.
        </h1>
        <p class="hero__sub lede reveal">
          TalentDigital aide les PME et les entrepreneurs à comprendre ce qui bloque, à décider où investir,
          puis à déployer les moyens qui produisent des résultats mesurables — site, tunnel, SEO, publicité,
          email, automatisation.
        </p>
        <div class="hero__cta reveal">
          <a href="/contact" class="btn">Discutons de votre projet
            <svg class="arr" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/methode" class="btn btn--ghost">Découvrir la méthode</a>
        </div>
        <p class="hero__micro">Premier échange sans engagement · Réponse sous 24 h ouvrées</p>
      </div>

      <aside class="hero__panel reveal" aria-label="Ce que vous obtenez avant de dépenser">
        <p class="hero__panel-h">Avant de dépenser</p>
        <ol class="hero__steps">
          <li><span>01</span><div><b>Un diagnostic écrit</b><p>Ce que vous faites, ce que ça produit, ce qui bloque.</p></div></li>
          <li><span>02</span><div><b>Un plan priorisé</b><p>Quel chantier d’abord, pour quel budget, avec quel indicateur.</p></div></li>
          <li><span>03</span><div><b>Un périmètre et un prix</b><p>Écrits avant de commencer, pas après.</p></div></li>
        </ol>
        <p class="hero__panel-note">Pas de devis sur une intuition.</p>
      </aside>
    </div>
  </section>

  <section class="section wrap" id="constat">
    <div class="split">
      <div class="reveal">
        <p class="section-label">Le constat</p>
        <h2>Le vrai problème n’est presque jamais celui qu’on croit.</h2>
        <p class="lede" style="margin-top:1.2rem">
          Une PME ne manque presque jamais d’outils. Elle manque d’une décision claire
          sur ce qu’elle doit faire ensuite — et d’un moyen simple de vérifier que ça marche.
        </p>
        <p class="lede" style="margin-top:1rem">
          C’est pour ça que nous commençons par un diagnostic, jamais par un devis.
        </p>
      </div>
      <div class="grid-1">
        <article class="card reveal">
          <h3 class="card__t">Le budget part dans tous les sens</h3>
          <p>Site refait, campagne lancée, contenu publié : l’activité est là, mais personne ne sait quelle ligne produit réellement des clients.</p>
        </article>
        <article class="card reveal">
          <h3 class="card__t">Personne ne tranche</h3>
          <p>Un prestataire par canal. Chacun optimise sa partie, aucun ne décide de l’ensemble. Le résultat est une addition de tactiques, pas une stratégie.</p>
        </article>
        <article class="card reveal">
          <h3 class="card__t">Les décisions se prennent à l’instinct</h3>
          <p>Sans indicateur choisi à l’avance, impossible de savoir quoi arrêter, quoi renforcer, ni quand changer de cap.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section wrap" id="poles">
    <div class="section__head reveal">
      <p class="section-label">Les trois pôles</p>
      <h2>Diagnostiquer, décider, puis <em>déployer</em>.</h2>
      <p class="lede" style="margin-top:1rem">
        Trois pôles, une seule logique : la stratégie commande l’exécution. Vous pouvez entrer par le
        diagnostic, par l’acquisition ou par un support à construire — la méthode reste la même.
      </p>
    </div>
    <div class="pole-grid">
      {poles.map((pole) => (
        <article class="pole-card reveal">
          <span class="pole-card__no">{pole.no}</span>
          <span class="pole-card__kicker">{pole.kicker}</span>
          <h3>{pole.name}</h3>
          <p class="pole-card__promise">{pole.promise}</p>
          <p>{pole.desc}</p>
          <ul>
            {pole.items.map((item) => <li>{item}</li>)}
          </ul>
          <a class="pole-card__link" href={pole.href}>Découvrir ce pôle
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap" id="methode">
    <div class="section__head reveal">
      <p class="section-label">La méthode</p>
      <h2>Quatre étapes, aucune <em>zone d’ombre</em>.</h2>
      <p class="lede" style="margin-top:1rem">
        La même méthode s’applique à un audit seul, à une mission de conseil ou à un projet d’exécution.
        Chaque étape produit un livrable nommé, que vous gardez.
      </p>
    </div>
    <div class="method-grid reveal">
      {method.map((step) => (
        <article class="mstep">
          <span class="mstep__no">{step.no}</span>
          <span class="mstep__name">{step.name}</span>
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
          <p class="mstep__out"><b>Livrable</b>{step.deliverable}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap" id="livrables">
    <div class="section__head reveal">
      <p class="section-label">Preuves</p>
      <h2>Ce que vous recevez, <em>noir sur blanc</em>.</h2>
      <p class="lede" style="margin-top:1rem">
        Nous ne publions pas de témoignages inventés ni de chiffres de résultats garantis.
        La crédibilité vient de ce que nous produisons : des livrables nommés, un format, un contenu défini.
      </p>
    </div>
    <div class="deliver-grid reveal">
      {deliverables.map((item, i) => (
        <article class="deliver-item">
          <p class="deliver-item__no">{String(i + 1).padStart(2, '0')} — {item.format}</p>
          <h4>{item.name}</h4>
          <p>{item.contains}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap" id="perimetre">
    <div class="section__head reveal">
      <p class="section-label">Périmètre</p>
      <h2>Ce que nous faisons. Ce que nous ne faisons <em>pas</em>.</h2>
      <p class="lede" style="margin-top:1rem">
        Dire ce qu’on ne fait pas rassure plus que promettre de tout faire. Voici la limite, écrite noir sur blanc.
      </p>
    </div>
    <div class="scope-grid">
      <div class="scope-col scope-col--yes reveal">
        <h3>Nos engagements</h3>
        <ul class="scope-list">
          {scopes.yes.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="scope-col scope-col--no reveal">
        <h3>Ce que nous refusons</h3>
        <ul class="scope-list">
          {scopes.no.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section wrap" id="pour-qui">
    <div class="section__head reveal">
      <p class="section-label">Pour qui</p>
      <h2>Trois situations, un même point de départ : <em>comprendre</em>.</h2>
    </div>
    <div class="seg-grid">
      {segments.map((seg) => (
        <article class="seg-card reveal">
          <p class="seg-card__tag">{seg.tag}</p>
          <h3>{seg.name}</h3>
          <p class="seg-card__who">{seg.who}</p>
          <p>{seg.problem}</p>
          <p class="seg-card__msg">{seg.message}</p>
          <p class="seg-card__entry">Offre d’entrée · <b>{seg.entry}</b></p>
        </article>
      ))}
    </div>
    <p class="note reveal" style="margin-top:1.6rem">
      Marché d’ancrage : <b>Maroc</b>. Interventions également en France, Belgique, Suisse, Canada et Afrique francophone.
    </p>
  </section>

  <section class="section wrap" id="faq">
    <div class="faq__grid">
      <div class="reveal">
        <p class="section-label">Questions fréquentes</p>
        <h2>Les questions qu’on nous pose avant de <em>commencer</em>.</h2>
        <p class="lede" style="margin-top:1rem">
          Une autre question ? Écrivez-nous, la réponse arrive sous 24 h ouvrées.
        </p>
        <a href="/contact" class="btn btn--ghost" style="margin-top:1.6rem">Poser une question</a>
      </div>
      <Faq items={faqHome} idPrefix="home-faq" />
    </div>
  </section>

  <Cta
    title="Votre prochaine décision marketing mérite mieux qu’une <em>intuition</em>."
    text="Un échange de 30 minutes suffit pour identifier ce qui bloque et ce qu’il faut traiter en priorité. Vous repartez avec une première lecture, même sans travailler avec nous."
    primaryLabel="Discutons de votre projet"
    primaryHref="/contact"
    secondaryLabel="Voir la méthode"
    secondaryHref="/methode"
  />

  <script type="application/ld+json" set:html={JSON.stringify(offersLd)} />
</BaseLayout>

<style>
  .hero{padding-top:clamp(2.8rem,6vw,4.5rem);padding-bottom:clamp(3rem,7vw,5.5rem)}
  .hero__grid{display:grid;grid-template-columns:1.5fr 1fr;gap:clamp(2rem,5vw,4.5rem);align-items:start;margin-top:1.4rem}
  .hero__sub{margin-top:1.6rem;max-width:50ch}
  .hero__cta{margin-top:2.2rem;display:flex;flex-wrap:wrap;gap:1rem 1.4rem;align-items:center}
  .hero__micro{margin-top:1.4rem;font-family:var(--mono);font-size:.74rem;color:var(--muted)}

  .hero__panel{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:1.6rem 1.5rem;position:sticky;top:96px}
  .hero__panel-h{font-family:var(--mono);font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--lime)}
  .hero__steps{list-style:none;margin-top:1.1rem;display:flex;flex-direction:column}
  .hero__steps li{display:flex;gap:.9rem;padding:1rem 0;border-top:1px solid var(--line)}
  .hero__steps li > span{font-family:var(--mono);font-size:.72rem;color:var(--muted);padding-top:.15rem}
  .hero__steps b{display:block;font-size:.98rem;font-weight:700;color:var(--txt)}
  .hero__steps p{font-size:.85rem;color:var(--muted);line-height:1.5;margin-top:.25rem}
  .hero__panel-note{margin-top:1rem;padding-top:1rem;border-top:1px dashed var(--line);font-family:var(--mono);font-size:.72rem;color:var(--txt)}

  .grid-1{display:grid;gap:1rem}
  .card__t{font-size:1.05rem;font-weight:800;letter-spacing:-.015em;margin-bottom:.5rem;color:var(--txt)}
  .card p{font-size:.9rem;color:var(--muted);line-height:1.6}
  .card{padding:1.5rem}
  .card:hover{transform:none;border-color:var(--line-2);box-shadow:none}

  .faq__grid{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(2rem,5vw,4.5rem);align-items:start}
  .faq__grid > :last-child{border-top:1px solid var(--line-2)}

  @media (max-width:960px){
    .hero__grid{grid-template-columns:1fr}
    .hero__panel{position:static}
    .faq__grid{grid-template-columns:1fr}
  }
</style>
