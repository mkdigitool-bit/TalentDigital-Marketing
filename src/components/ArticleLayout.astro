---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Cta from './Cta.astro';
import { site } from '../data/site';
import { getPost, getRelated, type PostMeta } from '../data/posts';

interface Props {
  slug: string;
  description: string;
}

const { slug, description } = Astro.props;
const post: PostMeta = getPost(slug);
const related = getRelated(slug);

const dateLabel = new Date(post.date).toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.seoTitle,
  description,
  datePublished: post.date,
  dateModified: post.updated ?? post.date,
  inLanguage: 'fr',
  wordCount: undefined,
  articleSection: post.category,
  url: `${site.domain}/blog/${post.slug}`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${site.domain}/blog/${post.slug}` },
  author: {
    '@type': 'Organization',
    name: site.name,
    url: site.domain,
  },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.domain,
  },
};
---

<BaseLayout title={post.seoTitle} description={description}>
  <article class="article wrap">
    <Breadcrumbs items={[{ label: 'Ressources', href: '/blog' }, { label: post.title }]} />

    <header class="article__head">
      <p class="eyebrow">{post.category}</p>
      <h1 class="article__title reveal">{post.title}</h1>
      <p class="article-lede reveal">{post.lede}</p>
      <p class="article-meta reveal">
        <time datetime={post.date}>{dateLabel}</time>
        <span>{post.readingTime} de lecture</span>
        <span>TalentDigital</span>
      </p>
    </header>

    <div class="article__body">
      <div class="prose">
        <slot />
      </div>

      <aside class="article__aside" aria-label="Sommaire et à retenir">
        <div class="aside-box">
          <p class="aside-box__h">À retenir</p>
          <slot name="takeaways" />
        </div>
        <div class="aside-box">
          <p class="aside-box__h">Limites de cet article</p>
          <slot name="limits" />
        </div>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section wrap" aria-label="Articles liés">
      <div class="section__head reveal">
        <p class="section-label">À lire ensuite</p>
        <h2>Dans le même <em>fil</em>.</h2>
      </div>
      <div class="rel-grid">
        {related.map((r) => (
          <article class="article-card reveal">
            <p class="article-card__cat">{r.category}</p>
            <h3><a href={`/blog/${r.slug}`}>{r.title}</a></h3>
            <p>{r.why}</p>
            <p class="article-card__more">Lire →</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <Cta
    title="Ce texte pose un cadre. Votre situation mérite mieux qu’un <em>cadre</em>."
    text={post.ctaText}
    primaryLabel="Discutons de votre projet"
    primaryHref="/contact"
    secondaryLabel="Voir la méthode"
    secondaryHref="/methode"
  />

  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</BaseLayout>

<style>
  .article{padding-top:clamp(1.8rem,3.5vw,2.6rem)}
  .article__head{margin-top:1.8rem;padding-bottom:clamp(1.8rem,3.5vw,2.6rem);border-bottom:1px solid var(--line)}
  .article__title{font-size:clamp(1.9rem,4.2vw,3.1rem);font-weight:900;line-height:1.08;letter-spacing:-.035em;margin-top:.9rem;max-width:26ch;text-wrap:balance}
  .article__head .article-lede{margin-top:1.3rem}
  .article__head .article-meta{margin-top:1.6rem}

  .article__body{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:clamp(2rem,5vw,4rem);margin-top:clamp(2rem,4vw,3rem);align-items:start}
  .article__aside{display:flex;flex-direction:column;gap:1rem;position:sticky;top:96px}
  .aside-box{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:1.3rem}
  .aside-box__h{font-family:var(--mono);font-size:.66rem;letter-spacing:.12em;text-transform:uppercase;color:var(--lime);margin-bottom:.9rem}
  .aside-box :global(ul){list-style:none;display:flex;flex-direction:column;gap:.6rem}
  .aside-box :global(li){font-size:.83rem;color:var(--muted);line-height:1.5;padding-left:1rem;position:relative}
  .aside-box :global(li)::before{content:"—";position:absolute;left:0;color:var(--lime);font-family:var(--mono)}
  .aside-box p{font-size:.83rem;color:var(--muted);line-height:1.55}
  .aside-box__link{font-family:var(--mono);font-size:.7rem;letter-spacing:.06em;text-transform:uppercase;color:var(--txt)}
  .aside-box__link:hover{color:var(--lime)}

  .rel-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.2rem}
  .rel-grid .article-card h3 a{color:var(--txt);transition:color .2s}
  .rel-grid .article-card h3 a:hover{color:var(--lime)}

  @media (max-width:960px){
    .article__body{grid-template-columns:1fr}
    .article__aside{position:static}
  }
  @media (max-width:720px){.rel-grid{grid-template-columns:1fr}}
</style>
