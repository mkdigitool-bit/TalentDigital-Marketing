---
/**
 * Visuel de hero inspiré des scènes 3D du site Kora, reconstruit en CSS pur
 * (aucune dépendance WebGL, aucun asset externe, pas de loader animé).
 * Le composant remplit son conteneur `.hero-visual` : la scène ne passe
 * jamais derrière le texte, elle a son propre cadre.
 */
interface Props {
  variant: 'orbital' | 'tunnel' | 'panels' | 'cube';
}

const { variant } = Astro.props;
---

<div class="stage" data-variant={variant} aria-hidden="true">
  <div class="stage__grid"></div>
  <div class="stage__glow"></div>

  <div class="scene" data-parallax>
    {variant === 'orbital' && (
      <div class="orb">
        <span class="orb__core"></span>
        <span class="orb__ring orb__ring--a"></span>
        <span class="orb__ring orb__ring--b"></span>
        <span class="orb__ring orb__ring--c"></span>
        <span class="orb__sat orb__sat--a"></span>
        <span class="orb__sat orb__sat--b"></span>
      </div>
    )}

    {variant === 'tunnel' && (
      <div class="tunnel">
        <span class="tunnel__frame" style="--i:0"></span>
        <span class="tunnel__frame" style="--i:1"></span>
        <span class="tunnel__frame" style="--i:2"></span>
        <span class="tunnel__frame" style="--i:3"></span>
        <span class="tunnel__frame" style="--i:4"></span>
        <span class="tunnel__frame" style="--i:5"></span>
        <span class="tunnel__core"></span>
      </div>
    )}

    {variant === 'panels' && (
      <div class="panels">
        <span class="panels__card panels__card--a"></span>
        <span class="panels__card panels__card--b"></span>
        <span class="panels__card panels__card--c"></span>
        <span class="panels__rail"></span>
      </div>
    )}

    {variant === 'cube' && (
      <div class="cube">
        <span class="cube__face cube__face--front"></span>
        <span class="cube__face cube__face--back"></span>
        <span class="cube__face cube__face--right"></span>
        <span class="cube__face cube__face--left"></span>
        <span class="cube__face cube__face--top"></span>
        <span class="cube__face cube__face--bottom"></span>
        <span class="cube__node cube__node--a"></span>
        <span class="cube__node cube__node--b"></span>
      </div>
    )}
  </div>

  <div class="stage__scan"></div>
</div>

<script is:inline>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;
    var stages = document.querySelectorAll('.stage[data-variant]');
    stages.forEach(function (stage) {
      var scene = stage.querySelector('[data-parallax]');
      if (!scene) return;
      var target = stage.parentNode;
      var raf = null;
      function move(e) {
        if (raf) return;
        raf = requestAnimationFrame(function () {
          raf = null;
          var r = target.getBoundingClientRect();
          var x = (e.clientX - r.left) / r.width - 0.5;
          var y = (e.clientY - r.top) / r.height - 0.5;
          scene.style.setProperty('--px', (x * 16).toFixed(2) + 'px');
          scene.style.setProperty('--py', (y * 12).toFixed(2) + 'px');
        });
      }
      target.addEventListener('pointermove', move, { passive: true });
      target.addEventListener('pointerleave', function () {
        scene.style.setProperty('--px', '0px');
        scene.style.setProperty('--py', '0px');
      });
    });
  })();
</script>

<style>
  .stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    perspective: 1000px;
    z-index: 0;
  }

  .stage__grid {
    position: absolute;
    left: -30%;
    right: -30%;
    bottom: -32%;
    height: 92%;
    --cell: 56px;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--accent) 18%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--accent) 13%, transparent) 1px, transparent 1px);
    background-size: var(--cell) var(--cell);
    transform: rotateX(68deg);
    transform-origin: 50% 100%;
    opacity: 0.42;
    mask-image: radial-gradient(ellipse at 50% 100%, #000 10%, transparent 70%);
    animation: gridDrift 26s linear infinite;
  }

  .stage__glow {
    position: absolute;
    right: -8%;
    top: -10%;
    width: 82%;
    aspect-ratio: 1;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 20%, transparent), transparent 64%);
    filter: blur(10px);
  }

  .stage__scan {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--txt) 5%, transparent) 0 1px,
      transparent 1px 4px
    );
    opacity: 0.45;
    mix-blend-mode: overlay;
  }

  .scene {
    position: absolute;
    top: 50%;
    left: 50%;
    height: 88%;
    aspect-ratio: 1;
    transform: translate3d(calc(-50% + var(--px, 0px)), calc(-50% + var(--py, 0px)), 0);
    transition: transform 420ms cubic-bezier(0.2, 0.7, 0.2, 1);
    transform-style: preserve-3d;
  }

  /* ---- Scène 1 : anneaux orbitaux ---- */
  .orb {
    position: absolute;
    inset: 8%;
    transform-style: preserve-3d;
  }

  .orb__core {
    position: absolute;
    inset: 38%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 28%, color-mix(in srgb, var(--accent) 78%, #fff), var(--accent) 46%, color-mix(in srgb, var(--accent) 30%, #000) 100%);
    box-shadow: 0 0 60px color-mix(in srgb, var(--accent) 32%, transparent);
  }

  .orb__ring {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--accent) 34%, transparent);
    border-radius: 50%;
    transform-style: preserve-3d;
  }

  .orb__ring--a {
    animation: spinA 18s linear infinite;
  }

  .orb__ring--b {
    inset: 12%;
    border-color: color-mix(in srgb, var(--txt) 22%, transparent);
    animation: spinB 24s linear infinite;
  }

  .orb__ring--c {
    inset: 24%;
    border-color: color-mix(in srgb, var(--accent) 18%, transparent);
    animation: spinC 30s linear infinite;
  }

  .orb__sat {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 18px color-mix(in srgb, var(--accent) 65%, transparent);
  }

  .orb__sat--a {
    top: 4%;
    left: 47%;
    animation: satA 11s linear infinite;
  }

  .orb__sat--b {
    bottom: 16%;
    right: 12%;
    animation: satB 15s linear infinite;
  }

  /* ---- Scène 2 : tunnel de cadres ---- */
  .tunnel {
    position: absolute;
    inset: 6%;
    transform-style: preserve-3d;
  }

  .tunnel__frame {
    position: absolute;
    inset: calc(var(--i) * 3.4%);
    border: 1px solid color-mix(in srgb, var(--accent) calc(42% - var(--i) * 6%), transparent);
    border-radius: 6px;
    transform: translateZ(calc(var(--i) * -46px));
    animation: tunnelBreath 7s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.55s);
  }

  .tunnel__core {
    position: absolute;
    inset: 44%;
    border-radius: 8px;
    background: color-mix(in srgb, var(--accent) 55%, transparent);
    filter: blur(14px);
    animation: tunnelPulse 4.4s ease-in-out infinite;
  }

  /* ---- Scène 3 : panneaux flottants ---- */
  .panels {
    position: absolute;
    inset: 6%;
    transform-style: preserve-3d;
  }

  .panels__card {
    position: absolute;
    width: 60%;
    height: 40%;
    border: 1px solid color-mix(in srgb, var(--accent) 24%, transparent);
    border-radius: 10px;
    background:
      linear-gradient(140deg, color-mix(in srgb, var(--accent) 20%, transparent), transparent 70%),
      color-mix(in srgb, var(--panel) 94%, transparent);
    backdrop-filter: blur(2px);
    box-shadow:
      0 26px 50px -30px rgba(0, 0, 0, 0.8),
      inset 0 1px 0 color-mix(in srgb, var(--txt) 10%, transparent);
  }

  .panels__card--a {
    top: 4%;
    left: 10%;
    transform: rotateY(-16deg) rotateX(8deg);
    animation: floatA 13s ease-in-out infinite;
  }

  .panels__card--b {
    top: 30%;
    left: 30%;
    transform: rotateY(-10deg) rotateX(4deg);
    border-color: color-mix(in srgb, var(--accent) 58%, transparent);
    animation: floatB 16s ease-in-out infinite;
  }

  .panels__card--c {
    top: 56%;
    left: 16%;
    transform: rotateY(-20deg) rotateX(10deg);
    animation: floatC 19s ease-in-out infinite;
  }

  .panels__rail {
    position: absolute;
    right: 8%;
    top: 12%;
    bottom: 12%;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--accent) 50%, transparent),
      transparent
    );
  }

  /* ---- Scène 4 : cube filaire ---- */
  .cube {
    --cube: 176px;
    --half: calc(var(--cube) / 2);
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--cube);
    height: var(--cube);
    margin: calc(var(--half) * -1) 0 0 calc(var(--half) * -1);
    transform-style: preserve-3d;
    animation: cubeSpin 22s linear infinite;
  }

  .stage[data-variant='cube'] {
    perspective: 700px;
  }

  .cube__face {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
    background: color-mix(in srgb, var(--accent) 4%, transparent);
  }

  .cube__face--front {
    transform: translateZ(var(--half));
  }
  .cube__face--back {
    transform: rotateY(180deg) translateZ(var(--half));
  }
  .cube__face--right {
    transform: rotateY(90deg) translateZ(var(--half));
  }
  .cube__face--left {
    transform: rotateY(-90deg) translateZ(var(--half));
  }
  .cube__face--top {
    transform: rotateX(90deg) translateZ(var(--half));
  }
  .cube__face--bottom {
    transform: rotateX(-90deg) translateZ(var(--half));
  }

  .cube__node {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 16px color-mix(in srgb, var(--accent) 70%, transparent);
    top: 50%;
    left: 50%;
  }

  .cube__node--a {
    animation: nodeA 9s ease-in-out infinite;
  }

  .cube__node--b {
    animation: nodeB 12s ease-in-out infinite;
  }

  @keyframes gridDrift {
    from {
      background-position: 0 0, 0 0;
    }
    to {
      background-position: 0 var(--cell), var(--cell) 0;
    }
  }

  @keyframes spinA {
    from {
      transform: rotateX(64deg) rotateZ(0deg);
    }
    to {
      transform: rotateX(64deg) rotateZ(360deg);
    }
  }

  @keyframes spinB {
    from {
      transform: rotateX(-52deg) rotateY(18deg) rotateZ(0deg);
    }
    to {
      transform: rotateX(-52deg) rotateY(18deg) rotateZ(360deg);
    }
  }

  @keyframes spinC {
    from {
      transform: rotateY(58deg) rotateZ(0deg);
    }
    to {
      transform: rotateY(58deg) rotateZ(-360deg);
    }
  }

  @keyframes satA {
    0% {
      transform: translate3d(0, 0, 40px) scale(0.9);
    }
    50% {
      transform: translate3d(24px, -18px, 90px) scale(1.15);
    }
    100% {
      transform: translate3d(0, 0, 40px) scale(0.9);
    }
  }

  @keyframes satB {
    0% {
      transform: translate3d(0, 0, -30px);
    }
    50% {
      transform: translate3d(-20px, 16px, 30px);
    }
    100% {
      transform: translate3d(0, 0, -30px);
    }
  }

  @keyframes tunnelBreath {
    0%,
    100% {
      transform: translateZ(calc(var(--i) * -46px)) scale(0.96);
      opacity: 0.85;
    }
    50% {
      transform: translateZ(calc(var(--i) * -46px + 26px)) scale(1.04);
      opacity: 1;
    }
  }

  @keyframes tunnelPulse {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(0.9);
    }
    50% {
      opacity: 1;
      transform: scale(1.12);
    }
  }

  @keyframes floatA {
    0%,
    100% {
      transform: rotateY(-16deg) rotateX(8deg) translate3d(0, 0, 0);
    }
    50% {
      transform: rotateY(-12deg) rotateX(5deg) translate3d(0, -14px, 34px);
    }
  }

  @keyframes floatB {
    0%,
    100% {
      transform: rotateY(-10deg) rotateX(4deg) translate3d(0, 0, 10px);
    }
    50% {
      transform: rotateY(-14deg) rotateX(7deg) translate3d(0, -20px, 48px);
    }
  }

  @keyframes floatC {
    0%,
    100% {
      transform: rotateY(-20deg) rotateX(10deg) translate3d(0, 0, -10px);
    }
    50% {
      transform: rotateY(-16deg) rotateX(6deg) translate3d(0, -10px, 22px);
    }
  }

  @keyframes cubeSpin {
    from {
      transform: rotateX(-18deg) rotateY(0deg);
    }
    to {
      transform: rotateX(-18deg) rotateY(360deg);
    }
  }

  @keyframes nodeA {
    0%,
    100% {
      transform: translate3d(-42px, -34px, 26px);
      opacity: 0.5;
    }
    50% {
      transform: translate3d(34px, 26px, 44px);
      opacity: 1;
    }
  }

  @keyframes nodeB {
    0%,
    100% {
      transform: translate3d(46px, 30px, -22px);
      opacity: 0.6;
    }
    50% {
      transform: translate3d(-30px, -40px, -40px);
      opacity: 1;
    }
  }

  @media (max-width: 880px) {
    .stage__grid {
      --cell: 44px;
    }

    .cube {
      --cube: 112px;
    }
  }

  /* en thème clair, les traits fins ont besoin d'un peu plus de contraste */
  :global([data-theme='light']) .panels__card {
    border-color: color-mix(in srgb, var(--accent) 42%, transparent);
    box-shadow:
      0 22px 44px -30px rgba(24, 29, 12, 0.3),
      inset 0 1px 0 color-mix(in srgb, var(--txt) 8%, transparent);
  }

  :global([data-theme='light']) .cube__face {
    border-color: color-mix(in srgb, var(--accent) 62%, transparent);
  }

  :global([data-theme='light']) .stage__glow {
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .stage * {
      animation: none !important;
    }

    .scene {
      transform: translate3d(-50%, -50%, 0);
      transition: none;
    }
  }
</style>
