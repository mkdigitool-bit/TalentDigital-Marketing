---
interface Props {
  title: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  note?: string;
}

const {
  title,
  text,
  primaryLabel = 'Discutons de votre projet',
  primaryHref = '/contact',
  secondaryLabel = 'Voir la méthode',
  secondaryHref = '/methode',
  note = 'Premier échange sans engagement · Réponse sous 24 h ouvrées',
} = Astro.props;
---

<section class="cta-band wrap" aria-label="Prochaine étape">
  <div class="cta-band__box reveal">
    <span class="cta-band__eyebrow">Prochaine étape</span>
    <h2 set:html={title} />
    {text && <p class="cta-band__text">{text}</p>}
    <div class="cta-band__actions">
      <a href={primaryHref} class="btn">{primaryLabel}
        <svg class="arr" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      {secondaryLabel && (
        <a href={secondaryHref} class="btn btn--ghost">{secondaryLabel}</a>
      )}
    </div>
    {note && <p class="cta-band__note">{note}</p>}
  </div>
</section>

<style>
  .cta-band{padding-block:var(--section)}
  .cta-band__box{background:var(--lime);color:var(--lime-ink);border-radius:8px;padding:clamp(2.2rem,5vw,4.2rem);position:relative;overflow:hidden}
  .cta-band__box::after{content:"";position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(14,14,16,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(14,14,16,.07) 1px,transparent 1px);background-size:40px 40px}
  .cta-band__box > *{position:relative;z-index:1}
  .cta-band__eyebrow{font-family:var(--mono);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(14,14,16,.65)}
  .cta-band h2{color:var(--lime-ink);max-width:22ch;margin-top:.7rem;font-size:clamp(1.8rem,3.6vw,2.9rem);line-height:1.05;letter-spacing:-.03em;font-weight:900}
  .cta-band h2 :global(em){font-style:normal;color:var(--lime-ink);text-decoration:underline;text-decoration-thickness:3px;text-underline-offset:5px}
  .cta-band__text{margin-top:1.1rem;max-width:52ch;color:rgba(14,14,16,.82);font-size:1rem;line-height:1.6}
  .cta-band__actions{margin-top:2rem;display:flex;flex-wrap:wrap;gap:1rem}
  .cta-band .btn{--bg:var(--lime-ink);--fg:var(--lime);--bd:var(--lime-ink)}
  .cta-band .btn:hover{box-shadow:0 14px 30px -14px rgba(14,14,16,.55)}
  .cta-band .btn--ghost{--bg:transparent;--fg:var(--lime-ink);--bd:rgba(14,14,16,.4)}
  .cta-band .btn--ghost:hover{--bd:var(--lime-ink);box-shadow:none}
  .cta-band__note{margin-top:1.4rem;font-family:var(--mono);font-size:.72rem;letter-spacing:.02em;color:rgba(14,14,16,.72)}
</style>
