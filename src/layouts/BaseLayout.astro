---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/v2.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, ogImages } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, ogImage, noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const route = Astro.url.pathname.replace(/\/+$/, '') || '/';
const ogImagePath = ogImage ?? ogImages[route] ?? '/og-default.png';
const ogImageURL = new URL(ogImagePath, Astro.site);
const fullTitle = title.includes('TalentDigital') ? title : `${title} — TalentDigital`;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.domain}/#organization`,
  name: site.name,
  url: site.domain,
  slogan: site.tagline,
  description:
    'Cabinet de conseil marketing et de solutions digitales pour les PME, les entrepreneurs et les entreprises de services francophones.',
  email: site.email,
  telephone: site.phone,
  image: `${site.domain}/og-default.png`,
  sameAs: Object.values(site.social),
  areaServed: site.areas,
  knowsAbout: [
    'Conseil marketing',
    'Stratégie marketing',
    'Référencement naturel',
    'Publicité digitale',
    'Email marketing',
    'Création de sites web',
    'Tunnels de vente',
    'Automatisation marketing',
  ],
};
---

<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="color-scheme" content="dark light" />
  <meta name="theme-color" content="#0E0E10" id="td-theme-color" />
  <script is:inline>
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('td-theme'); } catch (e) {}
      if (stored === 'light' || stored === 'dark') {
        document.documentElement.setAttribute('data-theme', stored);
        var meta = document.getElementById('td-theme-color');
        if (meta) meta.setAttribute('content', stored === 'light' ? '#F5F6F1' : '#0E0E10');
      }
    })();
  </script>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <meta name="p:domain_verify" content="71f3c032d00a4d8a5719b30a1c3a7bb1" />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="TalentDigital" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={fullTitle} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <script type="application/ld+json" set:html={JSON.stringify(organization)} />

  <!-- Google tag (GTM-K2SDWZMF) : présent sur toutes les pages, comme demandé
       par Google. Consent Mode v2 : aucun cookie de mesure avant acceptation. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    // Le consentement par défaut doit être poussé AVANT toute commande de la balise,
    // sinon GA4 dépose ses cookies dès le chargement de la page.
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500
    });
    gtag('js', new Date());
  </script>
  <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-K2SDWZMF"></script>

  <script is:inline>
    (function () {
      var KEY = 'td-consent';
      var stored = null;
      try { stored = localStorage.getItem(KEY); } catch (e) {}
      window.__tdConsent = stored;
      window.tdGrantConsent = function () {
        gtag('consent', 'update', {
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
          analytics_storage: 'granted'
        });
      };
      window.tdDenyConsent = function () {
        gtag('consent', 'update', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied'
        });
      };
      window.tdTrack = function (name, params) {
        if (window.__tdConsent !== 'granted') return;
        window.dataLayer = window.dataLayer || [];
        var payload = { event: name };
        if (params) {
          for (var k in params) {
            if (Object.prototype.hasOwnProperty.call(params, k)) payload[k] = params[k];
          }
        }
        window.dataLayer.push(payload);
      };
      if (stored === 'granted') window.tdGrantConsent();
      else if (stored === 'denied') window.tdDenyConsent();
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip">Aller au contenu</a>
  <Header />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer />

  <div class="consent" id="td-consent" role="dialog" aria-live="polite" aria-label="Consentement aux cookies de mesure">
    <div class="consent__in">
      <p>
        Nous utilisons un outil de mesure d'audience (Google Tag Manager) pour comprendre ce qui est utile sur ce site.
        Aucun cookie de mesure n'est déposé sans votre accord.
        <a href="/mentions-legales#cookies">En savoir plus</a>
      </p>
      <div class="consent__actions">
        <button type="button" class="btn btn--ghost" data-consent="denied">Tout refuser</button>
        <button type="button" class="btn" data-consent="granted">Accepter la mesure</button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var KEY = 'td-consent';
      var banner = document.getElementById('td-consent');
      if (!banner) return;
      if (window.__tdConsent === null) banner.classList.add('is-open');

      banner.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-consent]');
        if (!btn) return;
        var choice = btn.getAttribute('data-consent');
        try { localStorage.setItem(KEY, choice); } catch (err) {}
        window.__tdConsent = choice;
        banner.classList.remove('is-open');
        if (choice === 'granted') window.tdGrantConsent();
        else window.tdDenyConsent();
      });
    })();
  </script>

  <!-- Comportements partagés : révélation, accordéons, mesure des clics. -->
  <script is:inline>
    (function () {
      "use strict";
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var reveals = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        reveals.forEach(function (el) { el.classList.add('in'); });
      } else {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            var sibs = Array.prototype.slice.call(e.target.parentNode.querySelectorAll(':scope > .reveal'));
            var i = Math.max(sibs.indexOf(e.target), 0);
            var delay = Math.min(i, 5) * 70;
            e.target.style.transitionDelay = delay + 'ms';
            e.target.classList.add('in');
            io.unobserve(e.target);
            setTimeout(function () { e.target.style.transitionDelay = ''; }, delay + 750);
          });
        }, { threshold: 0.16, rootMargin: '0px 0px -8% 0px' });
        reveals.forEach(function (el) { io.observe(el); });
      }

      var accs = document.querySelectorAll('.acc__btn');
      accs.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var acc = btn.parentNode;
          var panel = btn.nextElementSibling;
          var open = acc.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (panel) panel.style.maxHeight = open ? panel.scrollHeight + 'px' : null;
        });
      });

      window.addEventListener('resize', function () {
        document.querySelectorAll('.acc.is-open .acc__panel').forEach(function (panel) {
          panel.style.maxHeight = panel.scrollHeight + 'px';
        });
      }, { passive: true });

      // CTA suivis : tout lien interne vers /contact ou /audit.
      document.addEventListener('click', function (e) {
        var a = e.target.closest('a');
        if (!a || typeof window.tdTrack !== 'function') return;
        var href = a.getAttribute('href') || '';
        if (href === '/contact') {
          window.tdTrack('cta_click', { cta: (a.textContent || '').trim().slice(0, 60), page: location.pathname, target: 'contact' });
        } else if (href === '/audit') {
          window.tdTrack('cta_click', { cta: (a.textContent || '').trim().slice(0, 60), page: location.pathname, target: 'audit' });
        } else if (/\.pdf($|\?)/.test(href)) {
          window.tdTrack('pdf_download', { file: href, page: location.pathname });
        }
      });
    })();
  </script>
</body>
</html>
